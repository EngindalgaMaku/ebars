r\no\nc\ne\ns\ns\na\nn\nd\ne\nn\ns\nu\nr\ne\nt\nh\na\nt\ne\nd\nu\nc\na\nt\no\nr\ns\nf\ne\ne\nl\nc\no\nn\nf\ni\nd\ne\nn\nt\ni\nn\nu\nt\ni\nl\ni\nz\ni\nn\ng\nt\nh\ne\ns\ne\nt\no\no\nl\ns . === Page 13 ===\n\n1\n3\n5 . D\ni\ns\nc\nu\ns\ns\ni\no\nn\nT\nh\ne\nf\ni\nn\nd\ni\nn\ng\ns\no\nf\nt\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\ns\nh\ne\nd\nl\ni\ng\nh\nt\no\nn\nt\nh\ne\ne\nv\no\nl\nv\ni\nn\ng\nr\no\nl\ne\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n,\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nt\nh\nr\no\nu\ng\nh\nt\nh\ne\nl\ne\nn\ns\no\nf\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\na\nn\nd\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n) . A\ns\nw\ne\nn\na\nv\ni\ng\na\nt\ne\nt\nh\ni\ns\nd\ni\ng\ni\nt\na\nl\nl\na\nn\nd\ns\nc\na\np\ne\n,\ni\nt\n’\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nt\no\nr\ne\nf\nl\ne\nc\nt\no\nn\nt\nh\ne\ni\nm\np\nl\ni\nc\na\nt\ni\no\nn\ns\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n,\nt\nh\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nt\nh\ne\ny\np\nr\ne\ns\ne\nn\nt\n,\na\nn\nd\nt\nh\ne\no\np\np\no\nr\nt\nu\nn\ni\nt\ni\ne\ns\nt\nh\ne\ny\nc\nr\ne\na\nt\ne\nf\no\nr\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\ne\nd\nu\nc\na\nt\no\nr\ns . 5 .
n\ng\ne\ns\nt\nh\ne\ny\np\nr\ne\ns\ne\nn\nt\n,\na\nn\nd\nt\nh\ne\no\np\np\no\nr\nt\nu\nn\ni\nt\ni\ne\ns\nt\nh\ne\ny\nc\nr\ne\na\nt\ne\nf\no\nr\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\ne\nd\nu\nc\na\nt\no\nr\ns . 5 . 1\nE\nm\nb\nr\na\nc\ni\nn\ng\nT\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nE\nd\nu\nc\na\nt\ni\no\nn\nO\nn\ne\no\nf\nt\nh\ne\nm\no\ns\nt\ne\nn\nc\no\nu\nr\na\ng\ni\nn\ng\no\nu\nt\nc\no\nm\ne\ns\no\nf\nt\nh\ni\ns\ns\nt\nu\nd\ny\ni\ns\nt\nh\ne\nh\ni\ng\nh\nl\ne\nv\ne\nl\no\nf\nf\na\nm\ni\nl\ni\na\nr\ni\nt\ny\na\nn\nd\nu\ns\na\ng\ne\no\nf\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\na\nm\no\nn\ng\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny . W\ni\nt\nh\n6\n0\n%\no\nf\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\n8\n0\n%\no\nf\nf\na\nc\nu\nl\nt\ny\nr\ne\np\no\nr\nt\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nw\ni\nt\nh\nt\nh\ne\ns\ne\nt\no\no\nl\ns\n,\ni\nt\n’\ns\nc\nl\ne\na\nr\nt\nh\na\nt\nt\nh\ne\nr\ne\ni\ns\na\ng\nr\no\nw\ni\nn\ng\na\nc\nc\ne\np\nt\na\nn\nc\ne\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nt\nh\ne\nc\nl\na\ns\ns\nr\no\no\nm . T\nh\ni\ns\ns\nh\ni\nf\nt\ni\ns\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\n,\na\ns\ni\nt\ni\nn\nd\ni\nc\na\nt\ne\ns\na\nw\ni\nl\nl\ni\nn\ng\nn\ne\ns\ns\nt\no\ne\nm\nb\nr\na\nc\ne\ni\nn\nn\no\nv\na\nt\ni\nv\ne\ns\no\nl\nu\nt\ni\no\nn\ns\nt\nh\na\nt\nc\na\nn\ne\nn\nh\na\nn\nc\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns .
s\na\nw\ni\nl\nl\ni\nn\ng\nn\ne\ns\ns\nt\no\ne\nm\nb\nr\na\nc\ne\ni\nn\nn\no\nv\na\nt\ni\nv\ne\ns\no\nl\nu\nt\ni\no\nn\ns\nt\nh\na\nt\nc\na\nn\ne\nn\nh\na\nn\nc\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns . T\nh\ne\np\no\ns\ni\nt\ni\nv\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\nr\na\nt\ni\nn\ng\ns\nf\nu\nr\nt\nh\ne\nr\nr\ne\ni\nn\nf\no\nr\nc\ne\nt\nh\ni\ns\nn\no\nt\ni\no\nn\n,\ns\nu\ng\ng\ne\ns\nt\ni\nn\ng\nt\nh\na\nt\nm\na\nn\ny\ne\nd\nu\nc\na\nt\no\nr\ns\na\nn\nd\ns\nt\nu\nd\ne\nn\nt\ns\nf\ni\nn\nd\nv\na\nl\nu\ne\ni\nn\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n[\n1\n1\n] . 5 . 2\nE\nn\nh\na\nn\nc\ni\nn\ng\nE\nn\ng\na\ng\ne\nm\ne\nn\nt\na\nn\nd\nP\ne\nr\ns\no\nn\na\nl\ni\nz\na\nt\ni\no\nn\nT\nh\ne\na\nb\ni\nl\ni\nt\ny\no\nf\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\nt\no\nf\no\ns\nt\ne\nr\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\na\nn\nd\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nl\ne\na\nr\nn\ni\nn\ng\ni\ns\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nn\no\nt\ne\nw\no\nr\nt\nh\ny .
L\nL\nM\ns\na\nn\nd\nR\nA\nG\nt\no\nf\no\ns\nt\ne\nr\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\na\nn\nd\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nl\ne\na\nr\nn\ni\nn\ng\ni\ns\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nn\no\nt\ne\nw\no\nr\nt\nh\ny . F\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\nh\ni\ng\nh\nl\ni\ng\nh\nt\ne\nd\nh\no\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nc\nr\ne\na\nt\ne\nm\no\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nv\ne\na\nn\nd\nt\na\ni\nl\no\nr\ne\nd\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\nw\nh\ni\nc\nh\ni\ns\nc\nr\nu\nc\ni\na\nl\ni\nn\nt\no\nd\na\ny\n’\ns\nd\ni\nv\ne\nr\ns\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\ns . P\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\nc\na\nn\nh\ne\nl\np\na\nd\nd\nr\ne\ns\ns\nt\nh\ne\nv\na\nr\ny\ni\nn\ng\nn\ne\ne\nd\ns\no\nf\ns\nt\nu\nd\ne\nn\nt\ns\n,\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\np\nr\no\ng\nr\ne\ns\ns\na\nt\nt\nh\ne\ni\nr\no\nw\nn\np\na\nc\ne\na\nn\nd\ne\nx\np\nl\no\nr\ne\nt\no\np\ni\nc\ns\nt\nh\na\nt\nr\ne\ns\no\nn\na\nt\ne\nw\ni\nt\nh\nt\nh\ne\nm .
s\n,\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\np\nr\no\ng\nr\ne\ns\ns\na\nt\nt\nh\ne\ni\nr\no\nw\nn\np\na\nc\ne\na\nn\nd\ne\nx\np\nl\no\nr\ne\nt\no\np\ni\nc\ns\nt\nh\na\nt\nr\ne\ns\no\nn\na\nt\ne\nw\ni\nt\nh\nt\nh\ne\nm . T\nh\ni\ns\na\nl\ni\ng\nn\ns\nw\ni\nt\nh\nc\no\nn\nt\ne\nm\np\no\nr\na\nr\ny\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\np\nh\ni\nl\no\ns\no\np\nh\ni\ne\ns\nt\nh\na\nt\np\nr\ni\no\nr\ni\nt\ni\nz\ne\ns\nt\nu\nd\ne\nn\nt\n-\nc\ne\nn\nt\ne\nr\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\n,\nm\na\nk\ni\nn\ng\ni\nt\ne\ns\ns\ne\nn\nt\ni\na\nl\nf\no\nr\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\nt\no\nc\no\nn\nt\ni\nn\nu\ne\ni\nn\nv\ne\ns\nt\ni\nn\ng\ni\nn\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns . 5 . 3\nA\nd\nd\nr\ne\ns\ns\ni\nn\ng\nD\na\nt\na\nP\nr\ni\nv\na\nc\ny\nC\no\nn\nc\ne\nr\nn\ns\nH\no\nw\ne\nv\ne\nr\n,\nt\nh\ne\nr\ne\ns\ne\na\nr\nc\nh\na\nl\ns\no\nu\nn\nc\no\nv\ne\nr\ne\nd\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nc\no\nn\nc\ne\nr\nn\ns\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny .
r\nn\ns\nH\no\nw\ne\nv\ne\nr\n,\nt\nh\ne\nr\ne\ns\ne\na\nr\nc\nh\na\nl\ns\no\nu\nn\nc\no\nv\ne\nr\ne\nd\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nc\no\nn\nc\ne\nr\nn\ns\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny . W\ni\nt\nh\n7\n0\n%\no\nf\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\n6\n0\n%\no\nf\nf\na\nc\nu\nl\nt\ny\ne\nx\np\nr\ne\ns\ns\ni\nn\ng\nw\no\nr\nr\ni\ne\ns\na\nb\no\nu\nt\nh\no\nw\nt\nh\ne\ni\nr\nd\na\nt\na\ni\ns\nh\na\nn\nd\nl\ne\nd\n,\ni\nt\n’\ns\nc\nl\ne\na\nr\nt\nh\na\nt\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\nm\nu\ns\nt\np\nr\ni\no\nr\ni\nt\ni\nz\ne\nt\nr\na\nn\ns\np\na\nr\ne\nn\nc\ny\na\nn\nd\ne\nt\nh\ni\nc\na\nl\np\nr\na\nc\nt\ni\nc\ne\ns . B\nu\ni\nl\nd\ni\nn\ng\nt\nr\nu\ns\nt\ni\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nf\no\nr\nt\nh\ne\ns\nu\nc\nc\ne\ns\ns\nf\nu\nl\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns . E\nd\nu\nc\na\nt\ni\no\nn\na\nl\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\ns\nh\no\nu\nl\nd\nt\na\nk\ne\np\nr\no\na\nc\nt\ni\nv\ne\ns\nt\ne\np\ns\nt\no\nc\no\nm\nm\nu\nn\ni\nc\na\nt\ne\nh\no\nw\nd\na\nt\na\ni\ns\nc\no\nl\nl\ne\nc\nt\ne\nd\n,\nu\ns\ne\nd\n,\na\nn\nd\np\nr\no\nt\ne\nc\nt\ne\nd\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\na\nl\nl\ns\nt\na\nk\ne\nh\no\nl\nd\ne\nr\ns\nf\ne\ne\nl\ns\ne\nc\nu\nr\ne\ni\nn\nt\nh\ne\ni\nr\ni\nn\nt\ne\nr\na\nc\nt\ni\no\nn\ns\nw\ni\nt\nh\nt\nh\ne\ns\ne\nt\no\no\nl\ns . 5 .
d\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\na\nl\nl\ns\nt\na\nk\ne\nh\no\nl\nd\ne\nr\ns\nf\ne\ne\nl\ns\ne\nc\nu\nr\ne\ni\nn\nt\nh\ne\ni\nr\ni\nn\nt\ne\nr\na\nc\nt\ni\no\nn\ns\nw\ni\nt\nh\nt\nh\ne\ns\ne\nt\no\no\nl\ns . 5 . 4\nO\nv\ne\nr\nc\no\nm\ni\nn\ng\nI\nm\np\nl\ne\nm\ne\nn\nt\na\nt\ni\no\nn\nC\nh\na\nl\nl\ne\nn\ng\ne\ns\nT\nh\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nf\na\nc\ne\nd\nb\ny\nf\na\nc\nu\nl\nt\ny\ni\nn\ni\nm\np\nl\ne\nm\ne\nn\nt\ni\nn\ng\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\nc\na\nn\nn\no\nt\nb\ne\no\nv\ne\nr\nl\no\no\nk\ne\nd . T\ne\nc\nh\nn\ni\nc\na\nl\ni\ns\ns\nu\ne\ns\n,\na\nl\na\nc\nk\no\nf\nt\nr\na\ni\nn\ni\nn\ng\n,\na\nn\nd\ne\nt\nh\ni\nc\na\nl\nc\no\nn\ns\ni\nd\ne\nr\na\nt\ni\no\nn\ns\nw\ne\nr\ne\nc\no\nm\nm\no\nn\nt\nh\ne\nm\ne\ns\ni\nn\nt\nh\ne\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns . T\nh\ne\ns\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nh\ni\ng\nh\nl\ni\ng\nh\nt\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\ns\nu\np\np\no\nr\nt\ns\ny\ns\nt\ne\nm\ns\nt\nh\na\nt\ne\nm\np\no\nw\ne\nr\ne\nd\nu\nc\na\nt\no\nr\ns\nt\no\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\nu\nt\ni\nl\ni\nz\ne\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns .
i\nv\ne\ns\nu\np\np\no\nr\nt\ns\ny\ns\nt\ne\nm\ns\nt\nh\na\nt\ne\nm\np\no\nw\ne\nr\ne\nd\nu\nc\na\nt\no\nr\ns\nt\no\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\nu\nt\ni\nl\ni\nz\ne\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns . I\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\ns\nh\no\nu\nl\nd\nc\no\nn\ns\ni\nd\ne\nr\no\nf\nf\ne\nr\ni\nn\ng\no\nn\ng\no\ni\nn\ng\np\nr\no\nf\ne\ns\ns\ni\no\nn\na\nl\nd\ne\nv\ne\nl\no\np\nm\ne\nn\nt\no\np\np\no\nr\nt\nu\nn\ni\nt\ni\ne\ns\n,\nw\no\nr\nk\ns\nh\no\np\ns\n,\na\nn\nd\nr\ne\ns\no\nu\nr\nc\ne\ns\nt\nh\na\nt\ne\nq\nu\ni\np\nf\na\nc\nu\nl\nt\ny\nw\ni\nt\nh\nt\nh\ne\ns\nk\ni\nl\nl\ns\nt\nh\ne\ny\nn\ne\ne\nd\nt\no\nn\na\nv\ni\ng\na\nt\ne\nt\nh\ne\nc\no\nm\np\nl\ne\nx\ni\nt\ni\ne\ns\no\nf\ni\nn\nt\ne\ng\nr\na\nt\ni\nn\ng\nA\nI\ni\nn\nt\no\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\n\n\n\n=== Page 14 ===\n\n1\n4\np\nr\na\nc\nt\ni\nc\ne\ns . 5 . 5\nT\nh\ne\nI\nm\np\no\nr\nt\na\nn\nc\ne\no\nf\nC\no\nl\nl\na\nb\no\nr\na\nt\ni\no\nn\nC\no\nl\nl\na\nb\no\nr\na\nt\ni\no\nn\ne\nm\ne\nr\ng\ne\nd\na\ns\na\nk\ne\ny\nt\nh\ne\nm\ne\ni\nn\nt\nh\ne\nd\ni\ns\nc\nu\ns\ns\ni\no\nn\ns\nw\ni\nt\nh\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns .
