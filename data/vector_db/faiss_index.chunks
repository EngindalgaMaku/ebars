": 1, "Kola": 3, "Fanta": 3} \n tatlilar = { "Baklava" : 8, "Şöbiyet" : 8, "Künefe" : 10} \n \n # "print()" komutları boşluk basmak için kullanılmıştır . print() \n print("Yiyecekler: {}" .format(yiyecek))  \n print("İçecekler: {}" .format(icecek))  \n print("Tatlılar: {}" .format(tatlilar))  \n print() \n \n def __init__( self, ucret = 0): \n  self.hesap = ucret \n  print("Hesap: {} ₺" .format( self.hesap))  \n  print() \n \n def YiyecekSec( self, secilenYiyecek ): \n  self.hesap += self.yiyecek[ secilenYiyecek ] \n \n def IcecekSec( self, secilenIcecek ): \n  self.hesap += self.icecek[ secilenIcecek ] \n \n def TatliSec( self, secilenTatli ): \n  self.hesap += self.tatlilar[ secilenTatli ] \n \n def Hesap(self): \n  print("Ödenecek miktar: {} ₺" .format( self.hesap))  \n \n \nAli = Restorant () \n \nAli.YiyecekSec(input( "Yiyecek: " )) \nAli.IcecekSec(input( "İçecek: " )) \nAli.TatliSec(input( "Tatlı: " )) \n \nAli.Hesap()  \n \n \n \n \n \n \n\n\n=== Page 24 ===\n\nKaynaklar:
