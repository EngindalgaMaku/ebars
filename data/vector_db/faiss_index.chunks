=== Page 1 ===\n\n1\nI\nn\nv\ne\ns\nt\ni\ng\na\nt\ni\nn\ng\nt\nh\ne\nI\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nL\ne\na\nr\nn\ni\nn\ng\nA\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nH\ni\ng\nh\ne\nr\nE\nd\nu\nc\na\nt\ni\no\nn\nA\nj\ni\nt\nS\ni\nn\ng\nh\n,\nB\ni\nh\na\nr\nN\na\nt\ni\no\nn\na\nl\nC\no\nl\nl\ne\ng\ne\n,\nP\na\nt\nn\na\nU\nn\ni\nv\ne\nr\ns\ni\nt\ny\n,\nI\nn\nd\ni\na\nA\nb\ns\nt\nr\na\nc\nt\nI\nn\nr\ne\nc\ne\nn\nt\ny\ne\na\nr\ns\n,\nt\nh\ne\nl\na\nn\nd\ns\nc\na\np\ne\no\nf\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\nh\na\ns\nb\ne\ne\nn\nd\nr\na\nm\na\nt\ni\nc\na\nl\nl\ny\nr\ne\ns\nh\na\np\ne\nd\nb\ny\nt\ne\nc\nh\nn\no\nl\no\ng\ni\nc\na\nl\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\ns\n,\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nt\nh\nr\no\nu\ng\nh\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns .
n\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns . I\nt\ne\nx\np\nl\no\nr\ne\ns\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n,\np\nr\no\nv\ni\nd\ni\nn\ng\na\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\na\nn\na\nl\ny\ns\ni\ns\no\nf\nt\nh\ne\ni\nr\ni\nm\np\nl\ni\nc\na\nt\ni\no\nn\ns\nf\no\nr\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng . T\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\np\na\np\ne\nr\nd\ne\nl\nv\ne\ns\ni\nn\nt\no\nh\no\nw\nt\nh\ne\ns\ne\ni\nn\nn\no\nv\na\nt\ni\nv\ne\nt\no\no\nl\ns\ni\nn\nt\ne\nr\ns\ne\nc\nt\na\nn\nd\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne . B\ny\ne\nx\na\nm\ni\nn\ni\nn\ng\nb\no\nt\nh\nt\nh\ne\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\na\ns\ns\no\nc\ni\na\nt\ne\nd\nw\ni\nt\nh\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n,\nI\nd\no\na\ni\nm\nt\no\np\nr\no\nv\ni\nd\ne\na\nn\nu\na\nn\nc\ne\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nt\nh\ne\ni\nr\ni\nm\np\nl\ni\nc\na\nt\ni\no\nn\ns\nf\no\nr\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng .
a\ni\nm\nt\no\np\nr\no\nv\ni\nd\ne\na\nn\nu\na\nn\nc\ne\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nt\nh\ne\ni\nr\ni\nm\np\nl\ni\nc\na\nt\ni\no\nn\ns\nf\no\nr\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng . T\nh\nr\no\nu\ng\nh\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\nt\nh\na\nt\nc\no\nm\nb\ni\nn\ne\ns\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\ns\nu\nr\nv\ne\ny\ns\na\nn\nd\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\n,\nI\ng\na\nt\nh\ne\nr\ne\nd\ni\nn\ns\ni\ng\nh\nt\ns\nf\nr\no\nm\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\na\nc\nr\no\ns\ns\nv\na\nr\ni\no\nu\ns\nu\nn\ni\nv\ne\nr\ns\ni\nt\ni\ne\ns . T\nh\ne\nf\ni\nn\nd\ni\nn\ng\ns\nr\ne\nv\ne\na\nl\nt\nh\na\nt\nw\nh\ni\nl\ne\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\nc\na\nn\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nl\ny\nb\no\no\ns\nt\ns\nt\nu\nd\ne\nn\nt\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\na\nn\nd\nf\na\nc\ni\nl\ni\nt\na\nt\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\n,\nt\nh\ne\nr\ne\na\nr\ne\na\nl\ns\no\np\nr\ne\ns\ns\ni\nn\ng\nc\no\nn\nc\ne\nr\nn\ns\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\na\nd\ne\nq\nu\na\nt\ne\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng .
s\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\na\nd\ne\nq\nu\na\nt\ne\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng . U\nl\nt\ni\nm\na\nt\ne\nl\ny\n,\nt\nh\ni\ns\ns\nt\nu\nd\ny\nh\ni\ng\nh\nl\ni\ng\nh\nt\ns\nt\nh\ne\ne\nx\nc\ni\nt\ni\nn\ng\np\no\ns\ns\ni\nb\ni\nl\ni\nt\ni\ne\ns\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\no\nf\nf\ne\nr\n,\nw\nh\ni\nl\ne\na\nl\ns\no\ne\nm\np\nh\na\ns\ni\nz\ni\nn\ng\nt\nh\ne\ni\nm\np\no\nr\nt\na\nn\nc\ne\no\nf\na\nd\nd\nr\ne\ns\ns\ni\nn\ng\nt\nh\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nt\nh\ne\ny\np\nr\ne\ns\ne\nn\nt\nt\no\ne\nn\ns\nu\nr\ne\na\nm\no\nr\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt . T\nh\ne\ns\nt\nu\nd\ny\ne\nm\np\nl\no\ny\ns\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\n,\nu\nt\ni\nl\ni\nz\ni\nn\ng\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\na\nn\nd\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nd\na\nt\na\nt\no\na\ns\ns\ne\ns\ns\nt\nh\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns .
t\na\nt\ni\nv\ne\nd\na\nt\na\nt\no\na\ns\ns\ne\ns\ns\nt\nh\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns . T\nh\ne\nf\ni\nn\nd\ni\nn\ng\ns\nr\ne\nv\ne\na\nl\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\no\np\np\no\nr\nt\nu\nn\ni\nt\ni\ne\ns\nf\no\nr\ni\nm\np\nr\no\nv\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\na\nn\nd\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\n,\nw\nh\ni\nl\ne\na\nl\ns\no\nh\ni\ng\nh\nl\ni\ng\nh\nt\ni\nn\ng\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nr\ne\nl\na\nt\ne\nd\nt\no\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng . 1 . I\nn\nt\nr\no\nd\nu\nc\nt\ni\no\nn\nT\nh\ne\nw\no\nr\nl\nd\no\nf\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\ni\ns\nc\nh\na\nn\ng\ni\nn\ng\nf\na\ns\nt\ne\nr\nt\nh\na\nn\ne\nv\ne\nr\n,\nt\nh\na\nn\nk\ns\nt\no\nt\nh\ne\nr\na\np\ni\nd\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny .
r\ne\nd\nu\nc\na\nt\ni\no\nn\ni\ns\nc\nh\na\nn\ng\ni\nn\ng\nf\na\ns\nt\ne\nr\nt\nh\na\nn\ne\nv\ne\nr\n,\nt\nh\na\nn\nk\ns\nt\no\nt\nh\ne\nr\na\np\ni\nd\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny . A\ns\ne\nd\nu\nc\na\nt\no\nr\ns\na\nn\nd\ns\nt\nu\nd\ne\nn\nt\ns\na\nl\ni\nk\ne\nn\na\nv\ni\ng\na\nt\ne\nt\nh\ni\ns\ne\nv\no\nl\nv\ni\nn\ng\nl\na\nn\nd\ns\nc\na\np\ne\n,\nt\no\no\nl\ns\nl\ni\nk\ne\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\na\nr\ne\nb\ne\nc\no\nm\ni\nn\ng\ni\nn\nc\nr\ne\na\ns\ni\nn\ng\nl\ny\np\nr\no\nm\ni\nn\ne\nn\nt . T\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nh\na\nv\ne\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nt\no\nt\nr\na\nn\ns\nf\no\nr\nm\nt\nh\ne\nw\na\ny\nw\ne\nt\ne\na\nc\nh\na\nn\nd\nl\ne\na\nr\nn\n,\nm\na\nk\ni\nn\ng\ne\nd\nu\nc\na\nt\ni\no\nn\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\n,\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\n,\na\nn\nd\ne\nf\nf\ne\nc\nt\ni\nv\ne .
h\ne\nw\na\ny\nw\ne\nt\ne\na\nc\nh\na\nn\nd\nl\ne\na\nr\nn\n,\nm\na\nk\ni\nn\ng\ne\nd\nu\nc\na\nt\ni\no\nn\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\n,\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\n,\na\nn\nd\ne\nf\nf\ne\nc\nt\ni\nv\ne . I\nm\na\ng\ni\nn\ne\na\nc\nl\na\ns\ns\nr\no\no\nm\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\nc\na\nn\nr\ne\nc\ne\ni\nv\ne\ni\nn\ns\nt\na\nn\nt\nf\ne\ne\nd\nb\na\nc\nk\no\nn\nt\nh\ne\ni\nr\nw\nr\ni\nt\ni\nn\ng\n,\no\nr\nw\nh\ne\nr\ne\nt\nh\ne\ny\nc\na\nn\ne\na\ns\ni\nl\ny\na\nc\nc\ne\ns\ns\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\na\ni\nl\no\nr\ne\nd\nt\no\nt\nh\ne\ni\nr\ns\np\ne\nc\ni\nf\ni\nc\nn\ne\ne\nd\ns . T\nh\ni\ns\ni\ns\nt\nh\ne\np\nr\no\nm\ni\ns\ne\nt\nh\na\nt\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\nh\no\nl\nd . L\nL\nM\ns\n,\ns\nu\nc\nh\na\ns\nO\np\ne\nn\nA\nI\n'\ns\nG\nP\nT\n-\n3\n,\na\nr\ne\nc\na\np\na\nb\nl\ne\no\nf\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nt\ne\nx\nt\na\nn\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nc\no\nn\nt\ne\nx\nt\n,\nw\nh\ni\nl\ne\nR\nA\nG\nc\no\nm\nb\ni\nn\ne\ns\nr\ne\nt\nr\ni\ne\nv\na\nl\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ni\no\nn\nt\ne\nc\nh\nn\ni\nq\nu\ne\ns\nt\no\np\nr\no\nv\ni\nd\ne\na\nc\nc\nu\nr\na\nt\ne\na\nn\nd\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\nr\ne\nl\ne\nv\na\nn\nt\nr\ne\ns\np\no\nn\ns\ne\ns .
a\nl\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ni\no\nn\nt\ne\nc\nh\nn\ni\nq\nu\ne\ns\nt\no\np\nr\no\nv\ni\nd\ne\na\nc\nc\nu\nr\na\nt\ne\na\nn\nd\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\nr\ne\nl\ne\nv\na\nn\nt\nr\ne\ns\np\no\nn\ns\ne\ns . T\no\ng\ne\nt\nh\ne\nr\n,\nt\nh\ne\ny\nc\na\nn\nc\nr\ne\na\nt\ne\na\nm\no\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nv\ne\na\nn\nd\ns\nu\np\np\no\nr\nt\ni\nv\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n[\n1\n]\n[\n2\n] . === Page 2 ===\n\n2\nO\nn\nt\nh\ne\no\nt\nh\ne\nr\nh\na\nn\nd\n,\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\np\nl\na\ny\ns\na\nc\nr\nu\nc\ni\na\nl\nr\no\nl\ne\ni\nn\nt\nh\ni\ns\ne\nq\nu\na\nt\ni\no\nn . B\ny\nc\no\nl\nl\ne\nc\nt\ni\nn\ng\na\nn\nd\na\nn\na\nl\ny\nz\ni\nn\ng\nd\na\nt\na\no\nn\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\na\nn\nd\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\nt\nh\na\nt\ni\nn\nf\no\nr\nm\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns .
g\na\ng\ne\nm\ne\nn\nt\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\nt\nh\na\nt\ni\nn\nf\no\nr\nm\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns . T\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\na\nl\nl\no\nw\ns\nf\no\nr\na\nm\no\nr\ne\nn\nu\na\nn\nc\ne\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\nl\ne\na\nr\nn\n,\ne\nn\na\nb\nl\ni\nn\ng\nt\na\ni\nl\no\nr\ne\nd\ni\nn\nt\ne\nr\nv\ne\nn\nt\ni\no\nn\ns\nt\nh\na\nt\nc\na\nn\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nl\ny\ni\nm\np\nr\no\nv\ne\no\nu\nt\nc\no\nm\ne\ns . H\no\nw\ne\nv\ne\nr\n,\na\ns\nw\ni\nt\nh\na\nn\ny\nt\ne\nc\nh\nn\no\nl\no\ng\ni\nc\na\nl\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\n,\nt\nh\ne\nr\ne\na\nr\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nt\no\nc\no\nn\ns\ni\nd\ne\nr . I\ns\ns\nu\ne\ns\nl\ni\nk\ne\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng\na\nr\ne\nc\nr\ni\nt\ni\nc\na\nl\nt\no\na\nd\nd\nr\ne\ns\ns\ni\nf\nw\ne\nw\na\nn\nt\nt\no\nf\nu\nl\nl\ny\nh\na\nr\nn\ne\ns\ns\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\no\no\nl\ns .
t\nr\na\ni\nn\ni\nn\ng\na\nr\ne\nc\nr\ni\nt\ni\nc\na\nl\nt\no\na\nd\nd\nr\ne\ns\ns\ni\nf\nw\ne\nw\na\nn\nt\nt\no\nf\nu\nl\nl\ny\nh\na\nr\nn\ne\ns\ns\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\no\no\nl\ns . I\nt\n’\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nt\no\ns\nt\nr\ni\nk\ne\na\nb\na\nl\na\nn\nc\ne\nb\ne\nt\nw\ne\ne\nn\ni\nn\nn\no\nv\na\nt\ni\no\nn\na\nn\nd\ne\nt\nh\ni\nc\na\nl\nc\no\nn\ns\ni\nd\ne\nr\na\nt\ni\no\nn\ns\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\na\nl\nl\ns\nt\nu\nd\ne\nn\nt\ns\nb\ne\nn\ne\nf\ni\nt\nf\nr\no\nm\nt\nh\ne\ns\ne\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\ns . T\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\np\na\np\ne\nr\na\ni\nm\ns\nt\no\ne\nx\np\nl\no\nr\ne\nt\nh\ne\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn . B\ny\ne\nx\na\nm\ni\nn\ni\nn\ng\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\n,\nI\nh\no\np\ne\nt\no\ns\nh\ne\nd\nl\ni\ng\nh\nt\no\nn\nh\no\nw\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne .
e\nd\nl\ni\ng\nh\nt\no\nn\nh\no\nw\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne . T\nh\nr\no\nu\ng\nh\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\nt\nh\na\nt\ni\nn\nc\nl\nu\nd\ne\ns\ns\nu\nr\nv\ne\ny\ns\na\nn\nd\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\n,\nI\nw\ni\nl\nl\np\nr\no\nv\ni\nd\ne\ni\nn\ns\ni\ng\nh\nt\ns\nf\nr\no\nm\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\n,\nu\nl\nt\ni\nm\na\nt\ne\nl\ny\nc\no\nn\nt\nr\ni\nb\nu\nt\ni\nn\ng\nt\no\na\nd\ne\ne\np\ne\nr\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\nw\ne\nc\na\nn\nn\na\nv\ni\ng\na\nt\ne\nt\nh\ni\ns\ne\nx\nc\ni\nt\ni\nn\ng\ny\ne\nt\nc\no\nm\np\nl\ne\nx\nl\na\nn\nd\ns\nc\na\np\ne . 1 . 1\nB\na\nc\nk\ng\nr\no\nu\nn\nd\nT\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\nh\na\ns\nb\ne\ne\nn\na\ng\na\nm\ne\n-\nc\nh\na\nn\ng\ne\nr\no\nv\ne\nr\nt\nh\ne\np\na\ns\nt\nf\ne\nw\ny\ne\na\nr\ns .
r\na\nt\ni\no\nn\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\nh\na\ns\nb\ne\ne\nn\na\ng\na\nm\ne\n-\nc\nh\na\nn\ng\ne\nr\no\nv\ne\nr\nt\nh\ne\np\na\ns\nt\nf\ne\nw\ny\ne\na\nr\ns . A\ns\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\ns\nt\nr\ni\nv\ne\nt\no\nk\ne\ne\np\np\na\nc\ne\nw\ni\nt\nh\nt\nh\ne\nd\ne\nm\na\nn\nd\ns\no\nf\na\nd\ni\ng\ni\nt\na\nl\nw\no\nr\nl\nd\n,\nt\no\no\nl\ns\nl\ni\nk\ne\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\na\nn\nd\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\nh\na\nv\ne\ne\nm\ne\nr\ng\ne\nd\na\ns\np\no\nw\ne\nr\nf\nu\nl\na\nl\nl\ni\ne\ns\ni\nn\nt\nh\ne\nq\nu\ne\ns\nt\nf\no\nr\ni\nm\np\nr\no\nv\ne\nd\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng .
o\nn\n(\nR\nA\nG\n)\nh\na\nv\ne\ne\nm\ne\nr\ng\ne\nd\na\ns\np\no\nw\ne\nr\nf\nu\nl\na\nl\nl\ni\ne\ns\ni\nn\nt\nh\ne\nq\nu\ne\ns\nt\nf\no\nr\ni\nm\np\nr\no\nv\ne\nd\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng . L\nL\nM\ns\n,\ns\nu\nc\nh\na\ns\nO\np\ne\nn\nA\nI\n'\ns\nG\nP\nT\n-\n3\n,\na\nr\ne\nd\ne\ns\ni\ng\nn\ne\nd\nt\no\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ne\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nt\ne\nx\nt\n,\nm\na\nk\ni\nn\ng\nt\nh\ne\nm\ni\nn\nc\nr\ne\nd\ni\nb\nl\ny\nu\ns\ne\nf\nu\nl\nf\no\nr\na\nv\na\nr\ni\ne\nt\ny\no\nf\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\na\np\np\nl\ni\nc\na\nt\ni\no\nn\ns\n—\nf\nr\no\nm\na\ns\ns\ni\ns\nt\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\ns\nw\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\nt\no\np\nr\no\nv\ni\nd\ni\nn\ng\ni\nn\ns\nt\na\nn\nt\na\nn\ns\nw\ne\nr\ns\nt\no\nc\no\nm\np\nl\ne\nx\nq\nu\ne\ns\nt\ni\no\nn\ns . O\nn\nt\nh\ne\no\nt\nh\ne\nr\nh\na\nn\nd\n,\nR\nA\nG\nt\na\nk\ne\ns\nt\nh\ni\ns\na\ns\nt\ne\np\nf\nu\nr\nt\nh\ne\nr\nb\ny\nc\no\nm\nb\ni\nn\ni\nn\ng\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nr\ne\nt\nr\ni\ne\nv\na\nl\na\nn\nd\nt\ne\nx\nt\ng\ne\nn\ne\nr\na\nt\ni\no\nn .
a\ns\nt\ne\np\nf\nu\nr\nt\nh\ne\nr\nb\ny\nc\no\nm\nb\ni\nn\ni\nn\ng\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nr\ne\nt\nr\ni\ne\nv\na\nl\na\nn\nd\nt\ne\nx\nt\ng\ne\nn\ne\nr\na\nt\ni\no\nn . T\nh\ni\ns\nm\ne\na\nn\ns\nt\nh\na\nt\ni\nn\ns\nt\ne\na\nd\no\nf\nj\nu\ns\nt\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\nr\ne\ns\np\no\nn\ns\ne\ns\nb\na\ns\ne\nd\no\nn\np\nr\ne\n-\ne\nx\ni\ns\nt\ni\nn\ng\nk\nn\no\nw\nl\ne\nd\ng\ne\n,\nR\nA\nG\nc\na\nn\np\nu\nl\nl\ni\nn\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nf\nr\no\nm\ne\nx\nt\ne\nr\nn\na\nl\ns\no\nu\nr\nc\ne\ns\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\nt\nh\ne\na\nn\ns\nw\ne\nr\ns\np\nr\no\nv\ni\nd\ne\nd\na\nr\ne\nn\no\nt\no\nn\nl\ny\nc\no\nh\ne\nr\ne\nn\nt\nb\nu\nt\na\nl\ns\no\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\na\nc\nc\nu\nr\na\nt\ne . T\nh\ni\ns\nc\na\np\na\nb\ni\nl\ni\nt\ny\ni\ns\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\no\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng\n[\n3\n] .
e\nt\nt\ni\nn\ng\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\no\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng\n[\n3\n] . M\ne\na\nn\nw\nh\ni\nl\ne\n,\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nh\na\ns\ng\na\ni\nn\ne\nd\nt\nr\na\nc\nt\ni\no\nn\na\ns\na\nw\na\ny\nt\no\nh\na\nr\nn\ne\ns\ns\nd\na\nt\na\nt\no\ni\nm\np\nr\no\nv\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\no\nu\nt\nc\no\nm\ne\ns . B\ny\na\nn\na\nl\ny\nz\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\na\nn\nd\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\nm\ne\nt\nr\ni\nc\ns\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\nl\ne\na\nr\nn\na\nn\nd\nw\nh\ne\nr\ne\nt\nh\ne\ny\nm\ni\ng\nh\nt\nb\ne\ns\nt\nr\nu\ng\ng\nl\ni\nn\ng . T\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\na\nl\nl\no\nw\ns\nf\no\nr\nm\no\nr\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\ne\nn\na\nb\nl\ni\nn\ng\ne\nd\nu\nc\na\nt\no\nr\ns\nt\no\nt\na\ni\nl\no\nr\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\nu\nn\ni\nq\nu\ne\nn\ne\ne\nd\ns\no\nf\ne\na\nc\nh\ns\nt\nu\nd\ne\nn\nt .
g\ne\nd\nu\nc\na\nt\no\nr\ns\nt\no\nt\na\ni\nl\no\nr\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\nu\nn\ni\nq\nu\ne\nn\ne\ne\nd\ns\no\nf\ne\na\nc\nh\ns\nt\nu\nd\ne\nn\nt . H\no\nw\ne\nv\ne\nr\n,\na\ns\np\nr\no\nm\ni\ns\ni\nn\ng\na\ns\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\na\nr\ne\n,\nt\nh\ne\ny\nc\no\nm\ne\nw\ni\nt\nh\nt\nh\ne\ni\nr\no\nw\nn\ns\ne\nt\no\nf\nc\nh\na\nl\nl\ne\nn\ng\ne\ns . C\no\nn\nc\ne\nr\nn\ns\na\nb\no\nu\nt\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nf\no\nr\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\na\nd\ne\nq\nu\na\nt\ne\nt\nr\na\ni\nn\ni\nn\ng\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nr\ne\na\nl\nl\nc\nr\ni\nt\ni\nc\na\nl\ni\ns\ns\nu\ne\ns\nt\nh\na\nt\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd .
o\nr\na\nd\ne\nq\nu\na\nt\ne\nt\nr\na\ni\nn\ni\nn\ng\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nr\ne\na\nl\nl\nc\nr\ni\nt\ni\nc\na\nl\ni\ns\ns\nu\ne\ns\nt\nh\na\nt\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd . U\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nt\nh\ni\ns\n\n\n\n=== Page 3 ===\n\n3\nb\na\nc\nk\ng\nr\no\nu\nn\nd\ni\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nf\no\nr\ne\nx\np\nl\no\nr\ni\nn\ng\nh\no\nw\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\ni\nn\nt\no\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n,\np\na\nv\ni\nn\ng\nt\nh\ne\nw\na\ny\nf\no\nr\na\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt . 2 . L\ni\nt\ne\nr\na\nt\nu\nr\ne\nR\ne\nv\ni\ne\nw\n2 . 1\nO\nv\ne\nr\nv\ni\ne\nw\no\nf\nL\nL\nM\ns\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\nh\na\nv\ne\nt\na\nk\ne\nn\nt\nh\ne\nw\no\nr\nl\nd\no\nf\nn\na\nt\nu\nr\na\nl\nl\na\nn\ng\nu\na\ng\ne\np\nr\no\nc\ne\ns\ns\ni\nn\ng\nb\ny\ns\nt\no\nr\nm .
r\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\nh\na\nv\ne\nt\na\nk\ne\nn\nt\nh\ne\nw\no\nr\nl\nd\no\nf\nn\na\nt\nu\nr\na\nl\nl\na\nn\ng\nu\na\ng\ne\np\nr\no\nc\ne\ns\ns\ni\nn\ng\nb\ny\ns\nt\no\nr\nm . T\nh\ne\ns\ne\nm\no\nd\ne\nl\ns\n,\nl\ni\nk\ne\nO\np\ne\nn\nA\nI\n'\ns\nG\nP\nT\n-\n3\na\nn\nd\nG\no\no\ng\nl\ne\n'\ns\nB\nE\nR\nT\n,\na\nr\ne\nt\nr\na\ni\nn\ne\nd\no\nn\nv\na\ns\nt\na\nm\no\nu\nn\nt\ns\no\nf\nt\ne\nx\nt\nd\na\nt\na\n,\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\ng\ne\nn\ne\nr\na\nt\ne\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nr\ne\ns\np\no\nn\ns\ne\ns\na\nn\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\nc\no\nn\nt\ne\nx\nt\ni\nn\nw\na\ny\ns\nt\nh\na\nt\nw\ne\nr\ne\np\nr\ne\nv\ni\no\nu\ns\nl\ny\nu\nn\ni\nm\na\ng\ni\nn\na\nb\nl\ne . R\ne\ns\ne\na\nr\nc\nh\nb\ny\nB\nr\no\nw\nn\ne\nt\na\nl . (\n2\n0\n2\n0\n)\nh\ni\ng\nh\nl\ni\ng\nh\nt\ns\nh\no\nw\nL\nL\nM\ns\nc\na\nn\np\ne\nr\nf\no\nr\nm\na\nv\na\nr\ni\ne\nt\ny\no\nf\nt\na\ns\nk\ns\n,\nf\nr\no\nm\na\nn\ns\nw\ne\nr\ni\nn\ng\nq\nu\ne\ns\nt\ni\no\nn\ns\nt\no\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\ne\ns\ns\na\ny\ns\n,\nm\na\nk\ni\nn\ng\nt\nh\ne\nm\ni\nn\nc\nr\ne\nd\ni\nb\nl\ny\nv\ne\nr\ns\na\nt\ni\nl\ne\nt\no\no\nl\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns .
t\no\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\ne\ns\ns\na\ny\ns\n,\nm\na\nk\ni\nn\ng\nt\nh\ne\nm\ni\nn\nc\nr\ne\nd\ni\nb\nl\ny\nv\ne\nr\ns\na\nt\ni\nl\ne\nt\no\no\nl\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns . T\nh\ne\ni\nr\na\nb\ni\nl\ni\nt\ny\nt\no\np\nr\no\nv\ni\nd\ne\ni\nn\ns\nt\na\nn\nt\nf\ne\ne\nd\nb\na\nc\nk\na\nn\nd\ns\nu\np\np\no\nr\nt\nc\na\nn\nb\ne\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nb\ne\nn\ne\nf\ni\nc\ni\na\nl\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns\nw\nh\no\nm\na\ny\ns\nt\nr\nu\ng\ng\nl\ne\nw\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\no\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\no\nn . 2 . 2\nU\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nR\nA\nG\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\ni\ns\na\nr\ne\nl\na\nt\ni\nv\ne\nl\ny\nn\ne\nw\na\np\np\nr\no\na\nc\nh\nt\nh\na\nt\nc\no\nm\nb\ni\nn\ne\ns\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\nb\no\nt\nh\nr\ne\nt\nr\ni\ne\nv\na\nl\n-\nb\na\ns\ne\nd\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ni\nv\ne\nm\no\nd\ne\nl\ns . A\nc\nc\no\nr\nd\ni\nn\ng\nt\no\nL\ne\nw\ni\ns\ne\nt\na\nl .
s\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\nb\no\nt\nh\nr\ne\nt\nr\ni\ne\nv\na\nl\n-\nb\na\ns\ne\nd\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ni\nv\ne\nm\no\nd\ne\nl\ns . A\nc\nc\no\nr\nd\ni\nn\ng\nt\no\nL\ne\nw\ni\ns\ne\nt\na\nl . (\n2\n0\n2\n0\n)\n,\nR\nA\nG\ne\nn\nh\na\nn\nc\ne\ns\nt\nh\ne\nc\na\np\na\nb\ni\nl\ni\nt\ni\ne\ns\no\nf\nL\nL\nM\ns\nb\ny\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\np\nu\nl\nl\ni\nn\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nf\nr\no\nm\ne\nx\nt\ne\nr\nn\na\nl\nd\na\nt\na\nb\na\ns\ne\ns\no\nr\nk\nn\no\nw\nl\ne\nd\ng\ne\nb\na\ns\ne\ns\nb\ne\nf\no\nr\ne\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\na\nr\ne\ns\np\no\nn\ns\ne . T\nh\ni\ns\nm\ne\na\nn\ns\nt\nh\na\nt\ni\nn\ns\nt\ne\na\nd\no\nf\nr\ne\nl\ny\ni\nn\ng\ns\no\nl\ne\nl\ny\no\nn\nt\nh\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\nh\ne\ny\nw\ne\nr\ne\nt\nr\na\ni\nn\ne\nd\no\nn\n,\nR\nA\nG\nm\no\nd\ne\nl\ns\nc\na\nn\na\nc\nc\ne\ns\ns\nu\np\n-\nt\no\n-\nd\na\nt\ne\na\nn\nd\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\nr\ne\nl\ne\nv\na\nn\nt\nd\na\nt\na\n[\n4\n] . T\nh\ni\ns\ni\ns\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nu\ns\ne\nf\nu\nl\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\nc\no\nn\nt\ne\nx\nt\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\n,\na\nc\nc\nu\nr\na\nt\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\no\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng .
s\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\n,\na\nc\nc\nu\nr\na\nt\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\no\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng . T\nh\ne\na\nb\ni\nl\ni\nt\ny\nt\no\nr\ne\nt\nr\ni\ne\nv\ne\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\ni\nn\nr\ne\na\nl\n-\nt\ni\nm\ne\nc\na\nn\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nl\ny\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne . 2 . 3\nL\ne\na\nr\nn\ni\nn\ng\nA\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nH\ni\ng\nh\ne\nr\nE\nd\nu\nc\na\nt\ni\no\nn\nL\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nh\na\ns\ne\nm\ne\nr\ng\ne\nd\na\ns\na\np\no\nw\ne\nr\nf\nu\nl\nt\no\no\nl\nf\no\nr\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\na\nn\nd\ni\nm\np\nr\no\nv\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\nl\ne\na\nr\nn\ni\nn\ng . B\ny\nc\no\nl\nl\ne\nc\nt\ni\nn\ng\na\nn\nd\na\nn\na\nl\ny\nz\ni\nn\ng\nd\na\nt\na\no\nn\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\n,\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\nb\ne\nh\na\nv\ni\no\nr\ns\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\na\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nn\ng\nw\ni\nt\nh\nc\no\nu\nr\ns\ne\nm\na\nt\ne\nr\ni\na\nl\ns .
o\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\na\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nn\ng\nw\ni\nt\nh\nc\no\nu\nr\ns\ne\nm\na\nt\ne\nr\ni\na\nl\ns . S\ni\ne\nm\ne\nn\ns\n(\n2\n0\n1\n3\n)\ne\nm\np\nh\na\ns\ni\nz\ne\ns\nt\nh\na\nt\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nc\na\nn\ni\nn\nf\no\nr\nm\ni\nn\ns\nt\nr\nu\nc\nt\ni\no\nn\na\nl\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\n,\nh\ne\nl\np\ni\nn\ng\ne\nd\nu\nc\na\nt\no\nr\ns\ni\nd\ne\nn\nt\ni\nf\ny\na\nt\n-\nr\ni\ns\nk\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nt\na\ni\nl\no\nr\ni\nn\nt\ne\nr\nv\ne\nn\nt\ni\no\nn\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\ni\nr\nn\ne\ne\nd\ns . T\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\nn\no\nt\no\nn\nl\ny\ne\nn\nh\na\nn\nc\ne\ns\nt\ne\na\nc\nh\ni\nn\ng\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\nb\nu\nt\na\nl\ns\no\nf\no\ns\nt\ne\nr\ns\na\nm\no\nr\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns . 2 .
f\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\nb\nu\nt\na\nl\ns\no\nf\no\ns\nt\ne\nr\ns\na\nm\no\nr\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns . 2 . 4\nR\ne\ns\ne\na\nr\nc\nh\nG\na\np\nD\ne\ns\np\ni\nt\ne\nt\nh\ne\ng\nr\no\nw\ni\nn\ng\ni\nn\nt\ne\nr\ne\ns\nt\ni\nn\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\n,\nt\nh\ne\nr\ne\ni\ns\na\nn\no\nt\ni\nc\ne\na\nb\nl\ne\ng\na\np\ni\nn\nt\nh\ne\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\ng\na\nr\nd\ni\nn\ng\nt\nh\ne\ni\nr\nc\no\nm\nb\ni\nn\ne\nd\ni\nm\np\na\nc\nt\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn . W\nh\ni\nl\ne\ni\nn\nd\ni\nv\ni\nd\nu\na\nl\ns\nt\nu\nd\ni\ne\ns\nh\na\nv\ne\ne\nx\np\nl\no\nr\ne\nd\ne\na\nc\nh\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n,\nf\ne\nw\nh\na\nv\ne\ne\nx\na\nm\ni\nn\ne\nd\nh\no\nw\nt\nh\ne\ny\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne .
i\ne\ns\n,\nf\ne\nw\nh\na\nv\ne\ne\nx\na\nm\ni\nn\ne\nd\nh\no\nw\nt\nh\ne\ny\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne . T\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\na\ni\nm\ns\nt\no\nf\ni\nl\nl\nt\nh\na\nt\ng\na\np\nb\ny\ni\nn\nv\ne\ns\nt\ni\ng\na\nt\ni\nn\ng\nt\nh\ne\n\n\n\n=== Page 4 ===\n\n4\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\na\nn\nd\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\ns\ne\nt\nt\ni\nn\ng\ns . B\ny\nd\no\ni\nn\ng\ns\no\n,\nI\nh\no\np\ne\nt\no\nc\no\nn\nt\nr\ni\nb\nu\nt\ne\nt\no\na\nm\no\nr\ne\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\nt\no\ni\nm\np\nr\no\nv\ne\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\no\nu\nt\nc\no\nm\ne\ns .
o\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\nt\no\ni\nm\np\nr\no\nv\ne\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\no\nu\nt\nc\no\nm\ne\ns . I\nn\ns\nu\nm\nm\na\nr\ny\n,\nt\nh\ne\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\nv\ne\na\nl\ns\na\np\nr\no\nm\ni\ns\ni\nn\ng\nl\na\nn\nd\ns\nc\na\np\ne\nf\no\nr\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn . T\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\n,\ns\nu\nc\nh\na\ns\ne\nn\nh\na\nn\nc\ne\nd\ns\nt\nu\nd\ne\nn\nt\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\na\nn\nd\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\nd\ne\nc\ni\ns\ni\no\nn\n-\nm\na\nk\ni\nn\ng\n,\na\nr\ne\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt . H\no\nw\ne\nv\ne\nr\n,\nt\nh\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\n—\nr\na\nn\ng\ni\nn\ng\nf\nr\no\nm\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\nc\no\nn\nc\ne\nr\nn\ns\nt\no\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng\n—\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd\nt\no\nf\nu\nl\nl\ny\nr\ne\na\nl\ni\nz\ne\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns .
c\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng\n—\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd\nt\no\nf\nu\nl\nl\ny\nr\ne\na\nl\ni\nz\ne\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns . T\nh\ni\ns\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\nv\ni\ne\nw\ns\ne\nt\ns\nt\nh\ne\ns\nt\na\ng\ne\nf\no\nr\nt\nh\ne\ns\nu\nb\ns\ne\nq\nu\ne\nn\nt\ne\nx\np\nl\no\nr\na\nt\ni\no\nn\no\nf\nh\no\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\nu\nt\ni\nl\ni\nz\ne\nd\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\nc\no\nn\nt\ne\nx\nt\ns\n,\np\na\nv\ni\nn\ng\nt\nh\ne\nw\na\ny\nf\no\nr\na\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt . 3 . M\ne\nt\nh\no\nd\no\nl\no\ng\ny\nT\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\ne\nm\np\nl\no\ny\ns\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\nt\no\ne\nx\np\nl\no\nr\ne\nt\nh\ne\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn .
)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn . B\ny\nc\no\nm\nb\ni\nn\ni\nn\ng\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\ns\nu\nr\nv\ne\ny\ns\na\nn\nd\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\n,\nI\na\ni\nm\nt\no\ng\na\nt\nh\ne\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\nd\na\nt\na\nt\nh\na\nt\nr\ne\nf\nl\ne\nc\nt\ns\nt\nh\ne\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\na\nn\nd\np\ne\nr\nc\ne\np\nt\ni\no\nn\ns\no\nf\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\nr\ne\ng\na\nr\nd\ni\nn\ng\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns . 3 . 1\nR\ne\ns\ne\na\nr\nc\nh\nD\ne\ns\ni\ng\nn\nT\nh\ne\nr\ne\ns\ne\na\nr\nc\nh\nd\ne\ns\ni\ng\nn\nc\no\nn\ns\ni\ns\nt\ns\no\nf\nt\nw\no\nm\na\ni\nn\nc\no\nm\np\no\nn\ne\nn\nt\ns\n:\na\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\ns\nu\nr\nv\ne\ny\na\nn\nd\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns .
i\ng\nn\nc\no\nn\ns\ni\ns\nt\ns\no\nf\nt\nw\no\nm\na\ni\nn\nc\no\nm\np\no\nn\ne\nn\nt\ns\n:\na\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\ns\nu\nr\nv\ne\ny\na\nn\nd\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns . T\nh\ni\ns\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\na\nl\nl\no\nw\ns\nf\no\nr\na\nm\no\nr\ne\nh\no\nl\ni\ns\nt\ni\nc\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nt\nh\ne\ni\nm\np\na\nc\nt\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns . 3 . 2\nD\na\nt\na\nC\no\nl\nl\ne\nc\nt\ni\no\nn\nQ\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nD\na\nt\na\nA\ns\nu\nr\nv\ne\ny\nw\na\ns\nd\ne\nv\ne\nl\no\np\ne\nd\nt\no\nc\no\nl\nl\ne\nc\nt\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nd\na\nt\na\nf\nr\no\nm\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nc\nr\no\ns\ns\nv\na\nr\ni\no\nu\ns\nu\nn\ni\nv\ne\nr\ns\ni\nt\ni\ne\ns .
l\ne\nc\nt\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nd\na\nt\na\nf\nr\no\nm\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nc\nr\no\ns\ns\nv\na\nr\ni\no\nu\ns\nu\nn\ni\nv\ne\nr\ns\ni\nt\ni\ne\ns . T\nh\ne\ns\nu\nr\nv\ne\ny\ni\nn\nc\nl\nu\nd\ne\nd\nq\nu\ne\ns\nt\ni\no\nn\ns\nd\ne\ns\ni\ng\nn\ne\nd\nt\no\na\ns\ns\ne\ns\ns\n[\n5\n]\n:\n\nF\na\nm\ni\nl\ni\na\nr\ni\nt\ny\nw\ni\nt\nh\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\n\nP\ne\nr\nc\ne\ni\nv\ne\nd\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\ne\nn\nh\na\nn\nc\ni\nn\ng\nl\ne\na\nr\nn\ni\nn\ng\n\nC\no\nn\nc\ne\nr\nn\ns\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\na\nn\nd\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n\nO\nv\ne\nr\na\nl\nl\ns\na\nt\ni\ns\nf\na\nc\nt\ni\no\nn\nw\ni\nt\nh\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\no\no\nl\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\np\nr\na\nc\nt\ni\nc\ne\ns\nT\nh\ne\ns\nu\nr\nv\ne\ny\nw\na\ns\nd\ni\ns\nt\nr\ni\nb\nu\nt\ne\nd\ne\nl\ne\nc\nt\nr\no\nn\ni\nc\na\nl\nl\ny\nt\no\na\ns\na\nm\np\nl\ne\no\nf\n5\n0\n0\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\n1\n0\n0\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns .
r\nv\ne\ny\nw\na\ns\nd\ni\ns\nt\nr\ni\nb\nu\nt\ne\nd\ne\nl\ne\nc\nt\nr\no\nn\ni\nc\na\nl\nl\ny\nt\no\na\ns\na\nm\np\nl\ne\no\nf\n5\n0\n0\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\n1\n0\n0\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns . T\nh\ne\ns\na\nm\np\nl\ne\nw\na\ns\ns\nt\nr\na\nt\ni\nf\ni\ne\nd\nt\no\ne\nn\ns\nu\nr\ne\nr\ne\np\nr\ne\ns\ne\nn\nt\na\nt\ni\no\nn\na\nc\nr\no\ns\ns\nd\ni\nf\nf\ne\nr\ne\nn\nt\na\nc\na\nd\ne\nm\ni\nc\nd\ni\ns\nc\ni\np\nl\ni\nn\ne\ns\na\nn\nd\n\n\n\n=== Page 5 ===\n\n5\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns . T\nh\ne\ns\nu\nr\nv\ne\ny\nw\na\ns\nc\no\nn\nd\nu\nc\nt\ne\nd\no\nv\ne\nr\na\np\ne\nr\ni\no\nd\no\nf\nf\no\nu\nr\nw\ne\ne\nk\ns\n,\na\nn\nd\nr\ne\ns\np\no\nn\ns\ne\ns\nw\ne\nr\ne\nc\no\nl\nl\ne\nc\nt\ne\nd\nu\ns\ni\nn\ng\nG\no\no\ng\nl\ne\nF\no\nr\nm\ns . S\na\nm\np\nl\ne\nS\nu\nr\nv\ne\ny\nQ\nu\ne\ns\nt\ni\no\nn\ns\n:\nH\no\nw\nf\na\nm\ni\nl\ni\na\nr\na\nr\ne\ny\no\nu\nw\ni\nt\nh\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n) ? V\ne\nr\ny\nf\na\nm\ni\nl\ni\na\nr\nS\no\nm\ne\nw\nh\na\nt\nf\na\nm\ni\nl\ni\na\nr\nN\no\nt\nf\na\nm\ni\nl\ni\na\nr\na\nt\na\nl\nl\nH\na\nv\ne\ny\no\nu\nu\ns\ne\nd\na\nn\ny\nL\nL\nM\ns\no\nr\nR\nA\nG\nt\no\no\nl\ns\ni\nn\ny\no\nu\nr\ns\nt\nu\nd\ni\ne\ns\no\nr\nt\ne\na\nc\nh\ni\nn\ng ?
a\nm\ni\nl\ni\na\nr\nN\no\nt\nf\na\nm\ni\nl\ni\na\nr\na\nt\na\nl\nl\nH\na\nv\ne\ny\no\nu\nu\ns\ne\nd\na\nn\ny\nL\nL\nM\ns\no\nr\nR\nA\nG\nt\no\no\nl\ns\ni\nn\ny\no\nu\nr\ns\nt\nu\nd\ni\ne\ns\no\nr\nt\ne\na\nc\nh\ni\nn\ng ? Y\ne\ns\nN\no\nO\nn\na\ns\nc\na\nl\ne\no\nf\n1\nt\no\n5\n,\nh\no\nw\ne\nf\nf\ne\nc\nt\ni\nv\ne\nd\no\ny\no\nu\nb\ne\nl\ni\ne\nv\ne\nL\nL\nM\ns\na\nr\ne\ni\nn\ne\nn\nh\na\nn\nc\ni\nn\ng\ny\no\nu\nr\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne ? (\n1\n=\nN\no\nt\ne\nf\nf\ne\nc\nt\ni\nv\ne\n,\n5\n=\nV\ne\nr\ny\ne\nf\nf\ne\nc\nt\ni\nv\ne\n)\nW\nh\na\nt\nc\no\nn\nc\ne\nr\nn\ns\nd\no\ny\no\nu\nh\na\nv\ne\nr\ne\ng\na\nr\nd\ni\nn\ng\nt\nh\ne\nu\ns\ne\no\nf\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn ? (\nS\ne\nl\ne\nc\nt\na\nl\nl\nt\nh\na\nt\na\np\np\nl\ny\n)\nD\na\nt\na\np\nr\ni\nv\na\nc\ny\nA\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\nL\na\nc\nk\no\nf\nt\nr\na\ni\nn\ni\nn\ng\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nO\nt\nh\ne\nr\n(\np\nl\ne\na\ns\ne\ns\np\ne\nc\ni\nf\ny\n)\nO\nv\ne\nr\na\nl\nl\n,\nh\no\nw\ns\na\nt\ni\ns\nf\ni\ne\nd\na\nr\ne\ny\no\nu\nw\ni\nt\nh\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\ny\no\nu\nr\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne ?
f\ni\ne\nd\na\nr\ne\ny\no\nu\nw\ni\nt\nh\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\ny\no\nu\nr\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne ? V\ne\nr\ny\ns\na\nt\ni\ns\nf\ni\ne\nd\nS\na\nt\ni\ns\nf\ni\ne\nd\nN\ne\nu\nt\nr\na\nl\nD\ni\ns\ns\na\nt\ni\ns\nf\ni\ne\nd\nV\ne\nr\ny\nd\ni\ns\ns\na\nt\ni\ns\nf\ni\ne\nd\n\n\n\n=== Page 6 ===\n\n6\nQ\nu\na\nl\ni\nt\na\nt\ni\nv\ne\nD\na\nt\na\nI\nn\n-\nd\ne\np\nt\nh\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\nw\ne\nr\ne\nc\no\nn\nd\nu\nc\nt\ne\nd\nw\ni\nt\nh\n2\n0\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\nw\nh\no\nh\na\nv\ne\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\nL\nL\nM\ns\na\nn\nd\nR\nA\nG\ni\nn\nt\no\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\np\nr\na\nc\nt\ni\nc\ne\ns . T\nh\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\na\ni\nm\ne\nd\nt\no\ng\na\nt\nh\ne\nr\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nt\nh\ne\ni\nr\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\n,\na\nn\nd\np\ne\nr\nc\ne\ni\nv\ne\nd\nb\ne\nn\ne\nf\ni\nt\ns . T\nh\ne\ns\ne\nm\ni\n-\ns\nt\nr\nu\nc\nt\nu\nr\ne\nd\nf\no\nr\nm\na\nt\na\nl\nl\no\nw\ne\nd\nf\no\nr\nf\nl\ne\nx\ni\nb\ni\nl\ni\nt\ny\ni\nn\nr\ne\ns\np\no\nn\ns\ne\ns\nw\nh\ni\nl\ne\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\nk\ne\ny\nt\no\np\ni\nc\ns\nw\ne\nr\ne\nc\no\nv\ne\nr\ne\nd\n[\n6\n] .
a\nt\na\nl\nl\no\nw\ne\nd\nf\no\nr\nf\nl\ne\nx\ni\nb\ni\nl\ni\nt\ny\ni\nn\nr\ne\ns\np\no\nn\ns\ne\ns\nw\nh\ni\nl\ne\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\nk\ne\ny\nt\no\np\ni\nc\ns\nw\ne\nr\ne\nc\no\nv\ne\nr\ne\nd\n[\n6\n] . S\na\nm\np\nl\ne\nI\nn\nt\ne\nr\nv\ni\ne\nw\nQ\nu\ne\ns\nt\ni\no\nn\ns\n:\n\nC\na\nn\ny\no\nu\nd\ne\ns\nc\nr\ni\nb\ne\ny\no\nu\nr\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nu\ns\ni\nn\ng\nL\nL\nM\ns\no\nr\nR\nA\nG\ni\nn\ny\no\nu\nr\nt\ne\na\nc\nh\ni\nn\ng ? \nW\nh\na\nt\nb\ne\nn\ne\nf\ni\nt\ns\nh\na\nv\ne\ny\no\nu\no\nb\ns\ne\nr\nv\ne\nd\nf\nr\no\nm\ni\nn\nt\ne\ng\nr\na\nt\ni\nn\ng\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\ni\nn\nt\no\ny\no\nu\nr\nc\no\nu\nr\ns\ne\ns ? \nH\na\nv\ne\ny\no\nu\ne\nn\nc\no\nu\nn\nt\ne\nr\ne\nd\na\nn\ny\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\no\nr\nc\no\nn\nc\ne\nr\nn\ns\nw\nh\ni\nl\ne\nu\ns\ni\nn\ng\nL\nL\nM\ns\no\nr\nR\nA\nG ? I\nf\ns\no\n,\np\nl\ne\na\ns\ne\ne\nl\na\nb\no\nr\na\nt\ne . \nH\no\nw\nd\no\ny\no\nu\nt\nh\ni\nn\nk\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nc\no\nu\nl\nd\nb\ne\ni\nm\np\nr\no\nv\ne\nd\nf\no\nr\nb\ne\nt\nt\ne\nr\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn ?
t\nh\ni\nn\nk\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nc\no\nu\nl\nd\nb\ne\ni\nm\np\nr\no\nv\ne\nd\nf\no\nr\nb\ne\nt\nt\ne\nr\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn ? \nW\nh\na\nt\nt\nr\na\ni\nn\ni\nn\ng\no\nr\ns\nu\np\np\no\nr\nt\nd\no\ny\no\nu\nb\ne\nl\ni\ne\nv\ne\ni\ns\nn\ne\nc\ne\ns\ns\na\nr\ny\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\no\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\nu\ns\ne\nt\nh\ne\ns\ne\nt\no\no\nl\ns ? 3 . 3\nD\na\nt\na\nA\nn\na\nl\ny\ns\ni\ns\nQ\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nA\nn\na\nl\ny\ns\ni\ns\nT\nh\ne\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\nd\na\nt\na\nc\no\nl\nl\ne\nc\nt\ne\nd\nf\nr\no\nm\nt\nh\ne\ns\nu\nr\nv\ne\ny\ns\nw\ne\nr\ne\na\nn\na\nl\ny\nz\ne\nd\nu\ns\ni\nn\ng\ns\nt\na\nt\ni\ns\nt\ni\nc\na\nl\ns\no\nf\nt\nw\na\nr\ne\n(\ne . g . ,\nS\nP\nS\nS\no\nr\nR\n) . D\ne\ns\nc\nr\ni\np\nt\ni\nv\ne\ns\nt\na\nt\ni\ns\nt\ni\nc\ns\nw\ne\nr\ne\nu\ns\ne\nd\nt\no\ns\nu\nm\nm\na\nr\ni\nz\ne\nt\nh\ne\nr\ne\ns\np\no\nn\ns\ne\ns\n,\nw\nh\ni\nl\ne\ni\nn\nf\ne\nr\ne\nn\nt\ni\na\nl\ns\nt\na\nt\ni\ns\nt\ni\nc\ns\n(\ns\nu\nc\nh\na\ns\nr\ne\ng\nr\ne\ns\ns\ni\no\nn\na\nn\na\nl\ny\ns\ni\ns\n)\nw\ne\nr\ne\ne\nm\np\nl\no\ny\ne\nd\nt\no\ne\nx\np\nl\no\nr\ne\nr\ne\nl\na\nt\ni\no\nn\ns\nh\ni\np\ns\nb\ne\nt\nw\ne\ne\nn\nv\na\nr\ni\na\nb\nl\ne\ns .
u\nc\nh\na\ns\nr\ne\ng\nr\ne\ns\ns\ni\no\nn\na\nn\na\nl\ny\ns\ni\ns\n)\nw\ne\nr\ne\ne\nm\np\nl\no\ny\ne\nd\nt\no\ne\nx\np\nl\no\nr\ne\nr\ne\nl\na\nt\ni\no\nn\ns\nh\ni\np\ns\nb\ne\nt\nw\ne\ne\nn\nv\na\nr\ni\na\nb\nl\ne\ns . K\ne\ny\nm\ne\nt\nr\ni\nc\ns\n,\ns\nu\nc\nh\na\ns\nm\ne\na\nn\ns\n,\ns\nt\na\nn\nd\na\nr\nd\nd\ne\nv\ni\na\nt\ni\no\nn\ns\n,\na\nn\nd\nc\no\nr\nr\ne\nl\na\nt\ni\no\nn\nc\no\ne\nf\nf\ni\nc\ni\ne\nn\nt\ns\n,\nw\ne\nr\ne\nc\na\nl\nc\nu\nl\na\nt\ne\nd\nt\no\ni\nd\ne\nn\nt\ni\nf\ny\nt\nr\ne\nn\nd\ns\na\nn\nd\nh\nt\nt\np\ns\n:\n/\n/\no\np\ne\nn\na\ni . c\no\nm\np\na\nt\nt\ne\nr\nn\ns\ni\nn\nt\nh\ne\nd\na\nt\na . Q\nu\na\nl\ni\nt\na\nt\ni\nv\ne\nA\nn\na\nl\ny\ns\ni\ns\nT\nh\ne\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\nd\na\nt\na\nf\nr\no\nm\nt\nh\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\nw\ne\nr\ne\nt\nr\na\nn\ns\nc\nr\ni\nb\ne\nd\na\nn\nd\na\nn\na\nl\ny\nz\ne\nd\nu\ns\ni\nn\ng\nt\nh\ne\nm\na\nt\ni\nc\na\nn\na\nl\ny\ns\ni\ns . T\nh\ni\ns\ni\nn\nv\no\nl\nv\ne\nd\nc\no\nd\ni\nn\ng\nt\nh\ne\nt\nr\na\nn\ns\nc\nr\ni\np\nt\ns\nt\no\ni\nd\ne\nn\nt\ni\nf\ny\nr\ne\nc\nu\nr\nr\ni\nn\ng\nt\nh\ne\nm\ne\ns\na\nn\nd\np\na\nt\nt\ne\nr\nn\ns\ni\nn\nf\na\nc\nu\nl\nt\ny\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns .
d\ni\nn\ng\nt\nh\ne\nt\nr\na\nn\ns\nc\nr\ni\np\nt\ns\nt\no\ni\nd\ne\nn\nt\ni\nf\ny\nr\ne\nc\nu\nr\nr\ni\nn\ng\nt\nh\ne\nm\ne\ns\na\nn\nd\np\na\nt\nt\ne\nr\nn\ns\ni\nn\nf\na\nc\nu\nl\nt\ny\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns . T\nh\ne\nm\na\nt\ni\nc\na\nn\na\nl\ny\ns\ni\ns\na\nl\nl\no\nw\ns\nf\no\nr\na\nr\ni\nc\nh\nn\na\nr\nr\na\nt\ni\nv\ne\nt\nh\na\nt\nc\na\np\nt\nu\nr\ne\ns\nt\nh\ne\nn\nu\na\nn\nc\ne\ns\no\nf\ne\nd\nu\nc\na\nt\no\nr\ns\n'\np\ne\nr\ns\np\ne\nc\nt\ni\nv\ne\ns\no\nn\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns . 3 . 4\nD\na\nt\na\nS\no\nu\nr\nc\ne\ns\nT\nh\ne\nf\no\nl\nl\no\nw\ni\nn\ng\nw\ne\nb\ns\ni\nt\ne\ns\na\nn\nd\nd\na\nt\na\nb\na\ns\ne\ns\nw\ne\nr\ne\nu\nt\ni\nl\ni\nz\ne\nd\nt\no\ng\na\nt\nh\ne\nr\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\na\nn\nd\nr\ne\ns\no\nu\nr\nc\ne\ns\nf\no\nr\nt\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\n:\n\nO\np\ne\nn\nA\nI\n:\nh\nt\nt\np\ns\n:\n/\n/\no\np\ne\nn\na\ni . c\no\nm\n\nG\no\no\ng\nl\ne\nA\nI\n:\nh\nt\nt\np\ns\n:\n/\n/\na\ni . g\no\no\ng\nl\ne\n\n\n\n=== Page 7 ===\n\n7\n\nE\nD\nU\nC\nA\nU\nS\nE\n:\nh\nt\nt\np\ns\n:\n/\n/\nw\nw\nw . e\nd\nu\nc\na\nu\ns\ne . e\nd\nu\n\nT\nh\ne\nI\nn\nt\ne\nr\nn\na\nt\ni\no\nn\na\nl\nS\no\nc\ni\ne\nt\ny\nf\no\nr\nT\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nE\nd\nu\nc\na\nt\ni\no\nn\n:\nh\nt\nt\np\ns\n:\n/\n/\nw\nw\nw . i\ns\nt\ne .
