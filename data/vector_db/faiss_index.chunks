t\ni\nn\nt\nh\ne\ns\nt\nu\nd\ny\n.\nP\na\nr\nt\ni\nc\ni\np\na\nn\nt\ns\nw\ne\nr\ne\na\ns\ns\nu\nr\ne\nd\no\nf\nt\nh\ne\ni\nr\na\nn\no\nn\ny\nm\ni\nt\ny\na\nn\nd\nt\nh\ne\nc\no\nn\nf\ni\nd\ne\nn\nt\ni\na\nl\ni\nt\ny\no\nf\nt \nh\ne\ni\nr\nr\ne\ns\np\no\nn\ns\ne\ns\n.\nA\nd\nd\ni\nt\ni\no\nn\na\nl\nl\ny\n,\nt\nh\ne\nr\ne\ns\ne\na\nr\nc\nh\na\nd\nh\ne\nr\ne\nd\nt\no\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\na\nl\ng\nu\ni\nd\ne\nl\ni\nn\ne\ns\nf\no\nr\ne\nt\nh\ni\nc\na\nl\nr\ne\ns\ne\na\nr\nc\nh\np\nr\na\nc\nt\ni\nc\ne\ns\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\nd\na\nt\na\nc\no\nl\nl\ne\nc\nt\ni\no\nn\na\nn\nd\na\nn\na\nl\ny\ns\ni\ns\nw\ne\nr\ne\nc\no\nn\nd\nu\nc\nt\ne\nd\nr\ne\ns\np\no\nn\ns\ni\nb\nl\ny\n[\n7\n]\n.\n3\n.\n7\nL\ni\nm\ni\nt\na\nt\ni\no\nn\ns\nW\nh\ni\nl\ne\nt\nh\ni\ns\ns\nt\nu\nd\ny\na\ni\nm\ns\nt\no\np\nr\no\nv\ni\nd\ne\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\n,\ni\nt\ni\ns\ni\nm\np\no\nr\nt\na\nn\nt\nt\no\na\nc\nk\nn\no\nw\nl\ne\nd\ng\ne\ni\nt\ns\nl\ni\nm\ni\nt\na\nt\ni\no\nn\ns\n.\nT\nh\ne\ns\na\nm\np\nl\ne\ns\ni\nz\ne\n,\na\nl\nt\nh\no\nu\ng\nh\nd\ni\nv\ne\nr\ns\ne\n,\nm\na\ny\nn\no\nt\nf\nu\nl\nl\ny\nr\ne\np\nr\ne\ns\ne\nn\nt\nt\nh\ne\nb\nr\no\na\nd\ne\nr\np\no\np\nu\nl\na\nt\ni\no\nn\no\nf\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\na\nc\nr\no\ns\ns\na\nl\nl\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\n.\nF\nu\nr\nt\nh\ne\nr\nm\no\nr\ne
