b\nl\ne\nd\nt\nh\ne\nm\nt\no\nt\na\ni\nl\no\nr\nc\no\nn\nt\ne\nn\nt\nt\no\nm\ne\ne\nt\ni\nn\nd\ni\nv\ni\nd\nu\na\nl\ns\nt\nu\nd\ne\nn\nt\nn\ne\ne\nd\ns\n.\nT\nh\ni\ns\np\ne\nr\ns\no\nn\na\nl\ni\nz\na\nt\ni\no\nn\nf\no\ns\nt\n e\nr\ns\na\nm\no\nr\ne\ns\nu\np\np\no\nr\nt\ni\nv\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n,\nh\ne\nl\np\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\ns\nw\nh\no\nm\na\ny\ns\nt\nr\nu\ng\ng\nl\ne\nw\ni\nt\nh\nt\nr\na\nd\ni\nt\ni\no\nn\na\nl\nt\ne\na\nc\nh\ni\nn\ng\nm\ne\nt\nh\no\nd\ns\n.\n\nC\no\nn\nc\ne\nr\nn\ns\nA\nb\no\nu\nt\nD\na\nt\na\nP\nr\ni\nv\na\nc\ny\n:\nD\ne\ns\np\ni\nt\ne\nt\nh\ne\np\no\ns\ni\nt\ni\nv\ne\nf\ne\ne\nd\nb\na\nc\nk\n,\nt\nh\ne\nr\ne\nw\ne\nr\ne\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nc\no\nn\nc\ne\nr\nn\ns\nr\ne\ng\na\nr\nd\ni\nn\ng\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n.\nA\np\np\nr\no\nx\ni\nm\na\nt\ne\nl\ny\n7\n0\n%\no\nf\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\n6\n0\n%\no\nf\nf\na\nc\nu\nl\nt\ny\ne\nx\np\nr\ne\ns\ns\ne\nd\nw\no\nr\nr\ni\ne\ns\na\nb\no\nu\nt\nh\no\nw\nt\nh\ne\ni\nr\nd\na\nt\na\nm\ni\ng\nh\nt\nb\ne\nu\ns\ne\nd\na\nn\nd\np\nr\no\nt\ne\nc\nt\ne\nd\n.\nT\nh\ni\ns\nh\ni\ng\nh\nl\ni\ng\nh\nt\ns\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\nt\no\na\nd\nd\nr\ne\ns\ns\nt\nh\ne\ns\ne\nc\no\nn\nc\ne\nr\nn\ns\nt\nr\na\nn\ns\np\na\nr\ne\nn\nt\nl\ny\nt\no\nb\nu\ni\nl\nd\nt\nr\nu\ns\nt\na\nm\no\nn\ng\nu\ns\ne\nr\ns\n.\n\nO\nv\ne\nr\na\nl\nl
