g\ne\nt\nh\ne\nr\n,\nt\nh\ne\ny\nc\na\nn\nc\nr\ne\na\nt\ne\na\nm\no\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nv\ne\na\nn\nd\ns\nu\np\np\no\nr\nt\ni\nv\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n[\n1\n]\n[\n2\n]\n. === Page 2 ===
=== Page 2 === 2\nO\nn\nt\nh\ne\no\nt\nh\ne\nr\nh\na\nn\nd\n,\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\np\nl\na\ny\ns\na\nc\nr\nu\nc\ni\na\nl\nr\no\nl\ne\ni\nn\nt\nh\ni\ns\ne\nq\nu\na\nt\ni\no\nn\n.\nB\ny\nc\no\nl\nl\ne\nc\nt\ni\nn\ng\na\nn\nd\na\nn\na\nl\ny\nz\ni\nn\ng\nd\na\nt\na\no\nn\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\na\nn\nd\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\nt\nh\na\nt\ni\nn\nf\no\nr\nm\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\n.\nT\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\na\nl\nl\no\nw\ns\nf\no\nr\na\nm\no\nr\ne\nn\nu\na\nn\nc\ne\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\nl\ne\na\nr\nn\n,\ne\nn\na\nb\nl\ni\nn\ng\nt\na\ni\nl\no\nr\ne\nd\ni\nn\nt\ne\nr\nv\ne\nn\nt\ni\no\nn\ns\nt\nh\na\nt\nc\na\nn\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nl\ny\ni\nm\np\nr\no\nv\ne\no\nu\nt\nc\no\nm\ne\ns\n.\nH\no\nw\ne\nv\ne\nr\n,\na\ns\nw\ni\nt\nh\na\nn\ny\nt\ne\nc\nh\nn\no\nl\no\ng\ni\nc\na\nl\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\n,\nt\nh\ne\nr\ne\na\nr\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nt\no\nc\no\nn\ns
o\nu\nt\nc\no\nm\ne\ns\n.\nH\no\nw\ne\nv\ne\nr\n,\na\ns\nw\ni\nt\nh\na\nn\ny\nt\ne\nc\nh\nn\no\nl\no\ng\ni\nc\na\nl\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\n,\nt\nh\ne\nr\ne\na\nr\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\nt\no\nc\no\nn\ns\n i\nd\ne\nr\n.\nI\ns\ns\nu\ne\ns\nl\ni\nk\ne\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng\na\nr\ne\nc\nr\ni\nt\ni\nc\na\nl\nt\no\na\nd\nd\nr\ne\ns\ns\ni\nf\nw\ne\nw\na\nn\nt\nt\no\nf\nu\nl\nl\ny\nh\na\nr\nn\ne\ns\ns\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\no\no\nl\ns\n.\nI\nt\n’\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nt\no\ns\nt\nr\ni\nk\ne\na\nb\na\nl\na\nn\nc\ne\nb\ne\nt\nw\ne\ne\nn\ni\nn\nn\no\nv\na\nt\ni\no\nn\na\nn\nd\ne\nt\nh\ni\nc\na\nl\nc\no\nn\ns\ni\nd\ne\nr\na\nt\ni\no\nn\ns\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\na\nl\nl\ns\nt\nu\nd\ne\nn\nt\ns\nb\ne\nn\ne\nf\ni\nt\nf\nr\no\nm\nt\nh\ne\ns\ne\na\nd\nv\na\nn\nc\ne\nm\ne\nn\nt\ns\n.\nT\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\np\na\np\ne\nr\na\ni\nm\ns\nt\no\ne\nx\np\nl\no\nr\ne\nt\nh\ne\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nB\ny\ne\nx\na\nm\ni\nn\ni\nn\ng\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne
i\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nB\ny\ne\nx\na\nm\ni\nn\ni\nn\ng\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\n s\n,\nI\nh\no\np\ne\nt\no\ns\nh\ne\nd\nl\ni\ng\nh\nt\no\nn\nh\no\nw\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\n.\nT\nh\nr\no\nu\ng\nh\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\nt\nh\na\nt\ni\nn\nc\nl\nu\nd\ne\ns\ns\nu\nr\nv\ne\ny\ns\na\nn\nd\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\n,\nI\nw\ni\nl\nl\np\nr\no\nv\ni\nd\ne\ni\nn\ns\ni\ng\nh\nt\ns\nf\nr\no\nm\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\n,\nu\nl\nt\ni\nm\na\nt\ne\nl\ny\nc\no\nn\nt\nr\ni\nb\nu\nt\ni\nn\ng\nt\no\na\nd\ne\ne\np\ne\nr\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\nw\ne\nc\na\nn\nn\na\nv\ni\ng\na\nt\ne\nt\nh\ni\ns\ne\nx\nc\ni\nt\ni\nn\ng\ny\ne\nt\nc\no\nm\np\nl\ne\nx\nl\na\nn\nd\ns\nc\na\np\ne\n.\n1\n.\n1\nB\na\nc\nk\ng\nr\no\nu\nn\nd\nT\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nt\ne\nc\nh\nn\no\nl\no\ng\ny\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\nh\na\ns\nb\ne\ne\nn\na\ng\na\nm\ne\n-\nc\nh\na\nn\ng\ne\nr\no\nv\ne\nr\nt\nh\ne\np\na\ns\nt\nf\ne\nw\ny\ne\na\nr\ns\n.\nA\ns\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\ns
o\ng\ny\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\nh\na\ns\nb\ne\ne\nn\na\ng\na\nm\ne\n-\nc\nh\na\nn\ng\ne\nr\no\nv\ne\nr\nt\nh\ne\np\na\ns\nt\nf\ne\nw\ny\ne\na\nr\ns\n.\nA\ns\ni\nn\ns\nt\ni\nt\nu\nt\ni\no\nn\ns\ns\n t\nr\ni\nv\ne\nt\no\nk\ne\ne\np\np\na\nc\ne\nw\ni\nt\nh\nt\nh\ne\nd\ne\nm\na\nn\nd\ns\no\nf\na\nd\ni\ng\ni\nt\na\nl\nw\no\nr\nl\nd\n,\nt\no\no\nl\ns\nl\ni\nk\ne\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\na\nn\nd\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\nh\na\nv\ne\ne\nm\ne\nr\ng\ne\nd\na\ns\np\no\nw\ne\nr\nf\nu\nl\na\nl\nl\ni\ne\ns\ni\nn\nt\nh\ne\nq\nu\ne\ns\nt\nf\no\nr\ni\nm\np\nr\no\nv\ne\nd\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\n.\nL\nL\nM\ns\n,\ns\nu\nc\nh\na\ns\nO\np\ne\nn\nA\nI\n'\ns\nG\nP\nT\n-\n3\n,\na\nr\ne\nd\ne\ns\ni\ng\nn\ne\nd\nt\no\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ne\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nt\ne\nx\nt\n,\nm\na\nk\ni\nn\ng\nt\nh\ne\nm\ni\nn\nc\nr\ne\nd\ni\nb\nl\ny\nu\ns\ne\nf\nu\nl\nf\no\nr\na\nv\na\nr\ni\ne\nt\ny\no\nf\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\na\np\np\nl\ni\nc\na\nt\ni\no\nn\ns\n—\nf\nr\no\nm\na\ns\ns\ni\ns\nt\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\ns\nw\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\nt\no\np\nr\no\nv\ni\nd\ni\nn\ng\ni\nn\ns\nt\na\nn\nt\na\nn\ns\nw\ne\nr\ns\nt\no\nc\no\nm\np\nl\ne\nx\nq\nu\ne\ns\nt\ni\no\nn\ns\n.\nO\nn\nt
a\ns\ns\ni\ns\nt\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\ns\nw\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\nt\no\np\nr\no\nv\ni\nd\ni\nn\ng\ni\nn\ns\nt\na\nn\nt\na\nn\ns\nw\ne\nr\ns\nt\no\nc\no\nm\np\nl\ne\nx\nq\nu\ne\ns\nt\ni\no\nn\ns\n.\nO\nn\nt\n h\ne\no\nt\nh\ne\nr\nh\na\nn\nd\n,\nR\nA\nG\nt\na\nk\ne\ns\nt\nh\ni\ns\na\ns\nt\ne\np\nf\nu\nr\nt\nh\ne\nr\nb\ny\nc\no\nm\nb\ni\nn\ni\nn\ng\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nr\ne\nt\nr\ni\ne\nv\na\nl\na\nn\nd\nt\ne\nx\nt\ng\ne\nn\ne\nr\na\nt\ni\no\nn\n.\nT\nh\ni\ns\nm\ne\na\nn\ns\nt\nh\na\nt\ni\nn\ns\nt\ne\na\nd\no\nf\nj\nu\ns\nt\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\nr\ne\ns\np\no\nn\ns\ne\ns\nb\na\ns\ne\nd\no\nn\np\nr\ne\n-\ne\nx\ni\ns\nt\ni\nn\ng\nk\nn\no\nw\nl\ne\nd\ng\ne\n,\nR\nA\nG\nc\na\nn\np\nu\nl\nl\ni\nn\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nf\nr\no\nm\ne\nx\nt\ne\nr\nn\na\nl\ns\no\nu\nr\nc\ne\ns\n,\ne\nn\ns\nu\nr\ni\nn\ng\nt\nh\na\nt\nt\nh\ne\na\nn\ns\nw\ne\nr\ns\np\nr\no\nv\ni\nd\ne\nd\na\nr\ne\nn\no\nt\no\nn\nl\ny\nc\no\nh\ne\nr\ne\nn\nt\nb\nu\nt\na\nl\ns\no\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\na\nc\nc\nu\nr\na\nt\ne\n.\nT\nh\ni\ns\nc\na\np\na\nb\ni\nl\ni\nt\ny\ni\ns\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt
r\nl\ny\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\n o\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng\n[\n3\n]\n.\nM\ne\na\nn\nw\nh\ni\nl\ne\n,\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nh\na\ns\ng\na\ni\nn\ne\nd\nt\nr\na\nc\nt\ni\no\nn\na\ns\na\nw\na\ny\nt\no\nh\na\nr\nn\ne\ns\ns\nd\na\nt\na\nt\no\ni\nm\np\nr\no\nv\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\no\nu\nt\nc\no\nm\ne\ns\n.\nB\ny\na\nn\na\nl\ny\nz\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\na\nn\nd\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\nm\ne\nt\nr\ni\nc\ns\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\nl\ne\na\nr\nn\na\nn\nd\nw\nh\ne\nr\ne\nt\nh\ne\ny\nm\ni\ng\nh\nt\nb\ne\ns\nt\nr\nu\ng\ng\nl\ni\nn\ng\n.\nT\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\na\nl\nl\no\nw\ns\nf\no\nr\nm\no\nr\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\ne\nn\na\nb\nl\ni\nn\ng\ne\nd\nu\nc\na\nt\no\nr\ns\nt\no\nt\na\ni\nl\no\nr\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\nu\nn\ni\nq\nu\ne\nn\ne\ne\nd\ns\no\nf\ne\na\nc\nh\ns\nt\nu\nd\ne\nn\nt\n.\nH\no\nw\ne\nv\ne\nr\n,\na
s\nt\no\nt\na\ni\nl\no\nr\nt\nh\ne\ni\nr\nt\ne\na\nc\nh\ni\nn\ng\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\nu\nn\ni\nq\nu\ne\nn\ne\ne\nd\ns\no\nf\ne\na\nc\nh\ns\nt\nu\nd\ne\nn\nt\n.\nH\no\nw\ne\nv\ne\nr\n,\na\n s\np\nr\no\nm\ni\ns\ni\nn\ng\na\ns\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\na\nr\ne\n,\nt\nh\ne\ny\nc\no\nm\ne\nw\ni\nt\nh\nt\nh\ne\ni\nr\no\nw\nn\ns\ne\nt\no\nf\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\n.\nC\no\nn\nc\ne\nr\nn\ns\na\nb\no\nu\nt\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\n,\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nf\no\nr\na\nl\ng\no\nr\ni\nt\nh\nm\ni\nc\nb\ni\na\ns\n,\na\nn\nd\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\na\nd\ne\nq\nu\na\nt\ne\nt\nr\na\ni\nn\ni\nn\ng\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nr\ne\na\nl\nl\nc\nr\ni\nt\ni\nc\na\nl\ni\ns\ns\nu\ne\ns\nt\nh\na\nt\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd\n.\nU\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nt\nh\ni\ns
g\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nm\ne\nm\nb\ne\nr\ns\na\nr\ne\na\nl\nl\nc\nr\ni\nt\ni\nc\na\nl\ni\ns\ns\nu\ne\ns\nt\nh\na\nt\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd\n.\nU\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nt\nh\ni\ns === Page 3 ===
=== Page 3 === 3\nb\na\nc\nk\ng\nr\no\nu\nn\nd\ni\ns\ne\ns\ns\ne\nn\nt\ni\na\nl\nf\no\nr\ne\nx\np\nl\no\nr\ni\nn\ng\nh\no\nw\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\ni\nn\nt\no\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n,\np\na\nv\ni\nn\ng\nt\nh\ne\nw\na\ny\nf\no\nr\na\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n.\n2\n.\nL\ni\nt\ne\nr\na\nt\nu\nr\ne\nR\ne\nv\ni\ne\nw\n2\n.\n1\nO\nv\ne\nr\nv\ni\ne\nw\no\nf\nL\nL\nM\ns\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\nh\na\nv\ne\nt\na\nk\ne\nn\nt\nh\ne\nw\no\nr\nl\nd\no\nf\nn\na\nt\nu\nr\na\nl\nl\na\nn\ng\nu\na\ng\ne\np\nr\no\nc\ne\ns\ns\ni\nn\ng\nb\ny\ns\nt\no\nr\nm\n.\nT\nh\ne\ns\ne\nm\no\nd\ne\nl\ns\n,\nl\ni\nk\ne\nO\np\ne\nn\nA\nI\n'\ns\nG\nP\nT\n-\n3\na\nn\nd\nG\no\no\ng\nl\ne\n'\ns\nB\nE\nR\nT\n,\na\nr\ne\nt\nr\na\ni\nn\ne\nd\no\nn\nv\na\ns\nt\na\nm\no\nu\nn\nt\ns\no\nf\nt\ne\nx\nt\nd\na\nt\na\n,\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\ng\ne\nn\ne\nr\na\nt\ne\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nr\ne\ns\np\no
E\nR\nT\n,\na\nr\ne\nt\nr\na\ni\nn\ne\nd\no\nn\nv\na\ns\nt\na\nm\no\nu\nn\nt\ns\no\nf\nt\ne\nx\nt\nd\na\nt\na\n,\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\ng\ne\nn\ne\nr\na\nt\ne\nh\nu\nm\na\nn\n-\nl\ni\nk\ne\nr\ne\ns\np\no\n n\ns\ne\ns\na\nn\nd\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\nc\no\nn\nt\ne\nx\nt\ni\nn\nw\na\ny\ns\nt\nh\na\nt\nw\ne\nr\ne\np\nr\ne\nv\ni\no\nu\ns\nl\ny\nu\nn\ni\nm\na\ng\ni\nn\na\nb\nl\ne\n.\nR\ne\ns\ne\na\nr\nc\nh\nb\ny\nB\nr\no\nw\nn\ne\nt\na\nl\n.\n(\n2\n0\n2\n0\n)\nh\ni\ng\nh\nl\ni\ng\nh\nt\ns\nh\no\nw\nL\nL\nM\ns\nc\na\nn\np\ne\nr\nf\no\nr\nm\na\nv\na\nr\ni\ne\nt\ny\no\nf\nt\na\ns\nk\ns\n,\nf\nr\no\nm\na\nn\ns\nw\ne\nr\ni\nn\ng\nq\nu\ne\ns\nt\ni\no\nn\ns\nt\no\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\ne\ns\ns\na\ny\ns\n,\nm\na\nk\ni\nn\ng\nt\nh\ne\nm\ni\nn\nc\nr\ne\nd\ni\nb\nl\ny\nv\ne\nr\ns\na\nt\ni\nl\ne\nt\no\no\nl\ns\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ns\ne\nt\nt\ni\nn\ng\ns\n.\nT\nh\ne\ni\nr\na\nb\ni\nl\ni\nt\ny\nt\no\np\nr\no\nv\ni\nd\ne\ni\nn\ns\nt\na\nn\nt\nf\ne\ne\nd\nb\na\nc\nk\na\nn\nd\ns\nu\np\np\no\nr\nt\nc\na\nn\nb\ne\np\na\nr\nt\ni\nc\nu\nl\na\nr\nl\ny\nb\ne\nn\ne\nf\ni\nc\ni\na\nl\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns\nw\nh\no\nm\na\ny\ns\nt\nr\nu\ng\ng\nl\ne\nw\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\no\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\no\nn\n.\n2\n.\n2\nU\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nR\nA\nG\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn
w\ni\nt\nh\nw\nr\ni\nt\ni\nn\ng\no\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\no\nn\n.\n2\n.\n2\nU\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\nR\nA\nG\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n (\nR\nA\nG\n)\ni\ns\na\nr\ne\nl\na\nt\ni\nv\ne\nl\ny\nn\ne\nw\na\np\np\nr\no\na\nc\nh\nt\nh\na\nt\nc\no\nm\nb\ni\nn\ne\ns\nt\nh\ne\ns\nt\nr\ne\nn\ng\nt\nh\ns\no\nf\nb\no\nt\nh\nr\ne\nt\nr\ni\ne\nv\na\nl\n-\nb\na\ns\ne\nd\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ni\nv\ne\nm\no\nd\ne\nl\ns\n.\nA\nc\nc\no\nr\nd\ni\nn\ng\nt\no\nL\ne\nw\ni\ns\ne\nt\na\nl\n.\n(\n2\n0\n2\n0\n)\n,\nR\nA\nG\ne\nn\nh\na\nn\nc\ne\ns\nt\nh\ne\nc\na\np\na\nb\ni\nl\ni\nt\ni\ne\ns\no\nf\nL\nL\nM\ns\nb\ny\na\nl\nl\no\nw\ni\nn\ng\nt\nh\ne\nm\nt\no\np\nu\nl\nl\ni\nn\nr\ne\nl\ne\nv\na\nn\nt\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nf\nr\no\nm\ne\nx\nt\ne\nr\nn\na\nl\nd\na\nt\na\nb\na\ns\ne\ns\no\nr\nk\nn\no\nw\nl\ne\nd\ng\ne\nb\na\ns\ne\ns\nb\ne\nf\no\nr\ne\ng\ne\nn\ne\nr\na\nt\ni\nn\ng\na\nr\ne\ns\np\no\nn\ns\ne\n.\nT\nh\ni\ns\nm\ne\na\nn\ns\nt\nh\na\nt\ni\nn\ns\nt\ne\na\nd\no\nf\nr\ne\nl\ny\ni\nn\ng\ns\no\nl\ne\nl\ny\no\nn\nt\nh\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\nh\ne\ny\nw\ne\nr\ne\nt\nr\na\ni\nn\ne\nd\no\nn\n,\nR\nA\nG\nm\no\nd\ne\nl\ns\nc\na\nn\na\nc\nc\ne\ns\ns\nu\np\n-\nt\no\n-\nd\na\nt\ne\na\nn\nd\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\nr\ne\nl\ne\nv\na\nn\nt\nd\na\nt\na\n[\n4\n]\n.\nT\nh\ni\ns\ni\ns\np\na\nr\nt\ni\nc\nu\nl
n\n,\nR\nA\nG\nm\no\nd\ne\nl\ns\nc\na\nn\na\nc\nc\ne\ns\ns\nu\np\n-\nt\no\n-\nd\na\nt\ne\na\nn\nd\nc\no\nn\nt\ne\nx\nt\nu\na\nl\nl\ny\nr\ne\nl\ne\nv\na\nn\nt\nd\na\nt\na\n[\n4\n]\n.\nT\nh\ni\ns\ni\ns\np\na\nr\nt\ni\nc\nu\nl\n a\nr\nl\ny\nu\ns\ne\nf\nu\nl\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\nc\no\nn\nt\ne\nx\nt\ns\n,\nw\nh\ne\nr\ne\ns\nt\nu\nd\ne\nn\nt\ns\no\nf\nt\ne\nn\nn\ne\ne\nd\ns\np\ne\nc\ni\nf\ni\nc\n,\na\nc\nc\nu\nr\na\nt\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\nt\no\ns\nu\np\np\no\nr\nt\nt\nh\ne\ni\nr\nl\ne\na\nr\nn\ni\nn\ng\n.\nT\nh\ne\na\nb\ni\nl\ni\nt\ny\nt\no\nr\ne\nt\nr\ni\ne\nv\ne\na\nn\nd\ng\ne\nn\ne\nr\na\nt\ne\ni\nn\nf\no\nr\nm\na\nt\ni\no\nn\ni\nn\nr\ne\na\nl\n-\nt\ni\nm\ne\nc\na\nn\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\nl\ny\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\n.\n2\n.\n3\nL\ne\na\nr\nn\ni\nn\ng\nA\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nH\ni\ng\nh\ne\nr\nE\nd\nu\nc\na\nt\ni\no\nn\nL\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nh\na\ns\ne\nm\ne\nr\ng\ne\nd\na\ns\na\np\no\nw\ne\nr\nf\nu\nl\nt\no\no\nl\nf\no\nr\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\na\nn\nd\ni\nm\np\nr\no\nv\ni\nn\ng\ns\nt\nu\nd\ne\nn\nt\nl\ne\na\nr\nn\ni\nn\ng\n.\nB\ny\nc\no\nl\nl\ne\nc\nt\ni\nn\ng\na\nn\nd\na\nn\na\nl\ny\nz\ni\nn\ng\nd\na\nt\na\no\nn\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\n,\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\nb\ne\nh
.\nB\ny\nc\no\nl\nl\ne\nc\nt\ni\nn\ng\na\nn\nd\na\nn\na\nl\ny\nz\ni\nn\ng\nd\na\nt\na\no\nn\ns\nt\nu\nd\ne\nn\nt\np\ne\nr\nf\no\nr\nm\na\nn\nc\ne\n,\ne\nn\ng\na\ng\ne\nm\ne\nn\nt\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\nb\ne\nh\n a\nv\ni\no\nr\ns\n,\ne\nd\nu\nc\na\nt\no\nr\ns\nc\na\nn\ng\na\ni\nn\nv\na\nl\nu\na\nb\nl\ne\ni\nn\ns\ni\ng\nh\nt\ns\ni\nn\nt\no\nh\no\nw\ns\nt\nu\nd\ne\nn\nt\ns\na\nr\ne\ni\nn\nt\ne\nr\na\nc\nt\ni\nn\ng\nw\ni\nt\nh\nc\no\nu\nr\ns\ne\nm\na\nt\ne\nr\ni\na\nl\ns\n.\nS\ni\ne\nm\ne\nn\ns\n(\n2\n0\n1\n3\n)\ne\nm\np\nh\na\ns\ni\nz\ne\ns\nt\nh\na\nt\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\nc\na\nn\ni\nn\nf\no\nr\nm\ni\nn\ns\nt\nr\nu\nc\nt\ni\no\nn\na\nl\ns\nt\nr\na\nt\ne\ng\ni\ne\ns\n,\nh\ne\nl\np\ni\nn\ng\ne\nd\nu\nc\na\nt\no\nr\ns\ni\nd\ne\nn\nt\ni\nf\ny\na\nt\n-\nr\ni\ns\nk\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nt\na\ni\nl\no\nr\ni\nn\nt\ne\nr\nv\ne\nn\nt\ni\no\nn\ns\nt\no\nm\ne\ne\nt\nt\nh\ne\ni\nr\nn\ne\ne\nd\ns\n.\nT\nh\ni\ns\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\na\np\np\nr\no\na\nc\nh\nn\no\nt\no\nn\nl\ny\ne\nn\nh\na\nn\nc\ne\ns\nt\ne\na\nc\nh\ni\nn\ng\ne\nf\nf\ne\nc\nt\ni\nv\ne\nn\ne\ns\ns\nb\nu\nt\na\nl\ns\no\nf\no\ns\nt\ne\nr\ns\na\nm\no\nr\ne\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns\n.\n2\n.\n4\nR\ne\ns\ne\na\nr\nc\nh\nG\na\np\nD\ne\ns\np\ni\nt\ne\nt\nh\ne\ng\nr\no\nw\ni\nn\ng\ni\nn\nt\ne\nr\ne
o\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\nf\no\nr\ns\nt\nu\nd\ne\nn\nt\ns\n.\n2\n.\n4\nR\ne\ns\ne\na\nr\nc\nh\nG\na\np\nD\ne\ns\np\ni\nt\ne\nt\nh\ne\ng\nr\no\nw\ni\nn\ng\ni\nn\nt\ne\nr\ne\n s\nt\ni\nn\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\n,\nt\nh\ne\nr\ne\ni\ns\na\nn\no\nt\ni\nc\ne\na\nb\nl\ne\ng\na\np\ni\nn\nt\nh\ne\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\ng\na\nr\nd\ni\nn\ng\nt\nh\ne\ni\nr\nc\no\nm\nb\ni\nn\ne\nd\ni\nm\np\na\nc\nt\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nW\nh\ni\nl\ne\ni\nn\nd\ni\nv\ni\nd\nu\na\nl\ns\nt\nu\nd\ni\ne\ns\nh\na\nv\ne\ne\nx\np\nl\no\nr\ne\nd\ne\na\nc\nh\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n,\nf\ne\nw\nh\na\nv\ne\ne\nx\na\nm\ni\nn\ne\nd\nh\no\nw\nt\nh\ne\ny\nc\na\nn\nw\no\nr\nk\nt\no\ng\ne\nt\nh\ne\nr\nt\no\ne\nn\nh\na\nn\nc\ne\nt\nh\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\n.\nT\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\na\ni\nm\ns\nt\no\nf\ni\nl\nl\nt\nh\na\nt\ng\na\np\nb\ny\ni\nn\nv\ne\ns\nt\ni\ng\na\nt\ni\nn\ng\nt\nh\ne
n\nc\ne\nt\nh\ne\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\n.\nT\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\na\ni\nm\ns\nt\no\nf\ni\nl\nl\nt\nh\na\nt\ng\na\np\nb\ny\ni\nn\nv\ne\ns\nt\ni\ng\na\nt\ni\nn\ng\nt\nh\ne === Page 4 ===
=== Page 4 === 4\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\na\nn\nd\nt\nh\ne\ni\nr\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\na\nn\nd\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\ns\ne\nt\nt\ni\nn\ng\ns\n.\nB\ny\nd\no\ni\nn\ng\ns\no\n,\nI\nh\no\np\ne\nt\no\nc\no\nn\nt\nr\ni\nb\nu\nt\ne\nt\no\na\nm\no\nr\ne\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\nu\nn\nd\ne\nr\ns\nt\na\nn\nd\ni\nn\ng\no\nf\nh\no\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\ni\nn\nt\ne\ng\nr\na\nt\ne\nd\nt\no\ni\nm\np\nr\no\nv\ne\nt\ne\na\nc\nh\ni\nn\ng\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\no\nu\nt\nc\no\nm\ne\ns\n.\nI\nn\ns\nu\nm\nm\na\nr\ny\n,\nt\nh\ne\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\nv\ne\na\nl\ns\na\np\nr\no\nm\ni\ns\ni\nn\ng\nl\na\nn\nd\ns\nc\na\np\ne\nf\no\nr\nt\nh\ne\ni\nn\nt\ne\ng\nr\na\nt\ni\no\nn\no\nf\nL\nL\nM\ns\n,\nR\nA\nG\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nT\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\n,\ns\nu\nc\nh\na\ns\ne\nn\nh\na\nn\nc\ne\nd\ns\nt\nu\nd\ne\nn\nt\ne\nn\ng\na\ng\ne\nm\ne\nn
l\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nT\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\nb\ne\nn\ne\nf\ni\nt\ns\n,\ns\nu\nc\nh\na\ns\ne\nn\nh\na\nn\nc\ne\nd\ns\nt\nu\nd\ne\nn\nt\ne\nn\ng\na\ng\ne\nm\ne\nn\n t\n,\np\ne\nr\ns\no\nn\na\nl\ni\nz\ne\nd\nl\ne\na\nr\nn\ni\nn\ng\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\n,\na\nn\nd\nd\na\nt\na\n-\nd\nr\ni\nv\ne\nn\nd\ne\nc\ni\ns\ni\no\nn\n-\nm\na\nk\ni\nn\ng\n,\na\nr\ne\ns\ni\ng\nn\ni\nf\ni\nc\na\nn\nt\n.\nH\no\nw\ne\nv\ne\nr\n,\nt\nh\ne\nc\nh\na\nl\nl\ne\nn\ng\ne\ns\n—\nr\na\nn\ng\ni\nn\ng\nf\nr\no\nm\nd\na\nt\na\np\nr\ni\nv\na\nc\ny\nc\no\nn\nc\ne\nr\nn\ns\nt\no\nt\nh\ne\nn\ne\ne\nd\nf\no\nr\nf\na\nc\nu\nl\nt\ny\nt\nr\na\ni\nn\ni\nn\ng\n—\nm\nu\ns\nt\nb\ne\na\nd\nd\nr\ne\ns\ns\ne\nd\nt\no\nf\nu\nl\nl\ny\nr\ne\na\nl\ni\nz\ne\nt\nh\ne\np\no\nt\ne\nn\nt\ni\na\nl\no\nf\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n.\nT\nh\ni\ns\nl\ni\nt\ne\nr\na\nt\nu\nr\ne\nr\ne\nv\ni\ne\nw\ns\ne\nt\ns\nt\nh\ne\ns\nt\na\ng\ne\nf\no\nr\nt\nh\ne\ns\nu\nb\ns\ne\nq\nu\ne\nn\nt\ne\nx\np\nl\no\nr\na\nt\ni\no\nn\no\nf\nh\no\nw\nt\nh\ne\ns\ne\nt\no\no\nl\ns\nc\na\nn\nb\ne\ne\nf\nf\ne\nc\nt\ni\nv\ne\nl\ny\nu\nt\ni\nl\ni\nz\ne\nd\ni\nn\ne\nd\nu\nc\na\nt\ni\no\nn\na\nl\nc\no\nn\nt\ne\nx\nt\ns\n,\np\na\nv\ni\nn\ng\nt\nh\ne\nw\na\ny\nf\no\nr\na\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n.
t\ni\no\nn\na\nl\nc\no\nn\nt\ne\nx\nt\ns\n,\np\na\nv\ni\nn\ng\nt\nh\ne\nw\na\ny\nf\no\nr\na\nm\no\nr\ne\ne\nn\ng\na\ng\ni\nn\ng\na\nn\nd\ne\nq\nu\ni\nt\na\nb\nl\ne\nl\ne\na\nr\nn\ni\nn\ng\ne\nn\nv\ni\nr\no\nn\nm\ne\nn\nt\n.\n 3\n.\nM\ne\nt\nh\no\nd\no\nl\no\ng\ny\nT\nh\ni\ns\nr\ne\ns\ne\na\nr\nc\nh\ne\nm\np\nl\no\ny\ns\na\nm\ni\nx\ne\nd\n-\nm\ne\nt\nh\no\nd\ns\na\np\np\nr\no\na\nc\nh\nt\no\ne\nx\np\nl\no\nr\ne\nt\nh\ne\ni\nn\nt\ne\nr\ns\ne\nc\nt\ni\no\nn\no\nf\nL\na\nr\ng\ne\nL\na\nn\ng\nu\na\ng\ne\nM\no\nd\ne\nl\ns\n(\nL\nL\nM\ns\n)\n,\nR\ne\nt\nr\ni\ne\nv\na\nl\n-\nA\nu\ng\nm\ne\nn\nt\ne\nd\nG\ne\nn\ne\nr\na\nt\ni\no\nn\n(\nR\nA\nG\n)\n,\na\nn\nd\nl\ne\na\nr\nn\ni\nn\ng\na\nn\na\nl\ny\nt\ni\nc\ns\ni\nn\nh\ni\ng\nh\ne\nr\ne\nd\nu\nc\na\nt\ni\no\nn\n.\nB\ny\nc\no\nm\nb\ni\nn\ni\nn\ng\nq\nu\na\nn\nt\ni\nt\na\nt\ni\nv\ne\ns\nu\nr\nv\ne\ny\ns\na\nn\nd\nq\nu\na\nl\ni\nt\na\nt\ni\nv\ne\ni\nn\nt\ne\nr\nv\ni\ne\nw\ns\n,\nI\na\ni\nm\nt\no\ng\na\nt\nh\ne\nr\nc\no\nm\np\nr\ne\nh\ne\nn\ns\ni\nv\ne\nd\na\nt\na\nt\nh\na\nt\nr\ne\nf\nl\ne\nc\nt\ns\nt\nh\ne\ne\nx\np\ne\nr\ni\ne\nn\nc\ne\ns\na\nn\nd\np\ne\nr\nc\ne\np\nt\ni\no\nn\ns\no\nf\nb\no\nt\nh\ns\nt\nu\nd\ne\nn\nt\ns\na\nn\nd\nf\na\nc\nu\nl\nt\ny\nr\ne\ng\na\nr\nd\ni\nn\ng\nt\nh\ne\ns\ne\nt\ne\nc\nh\nn\no\nl\no\ng\ni\ne\ns\n.\n3\n.\n1\nR\ne\ns\ne\na\nr\nc\nh\nD\ne\ns\ni\ng\nn\nT\nh\ne\nr\ne\ns\ne\na\nr\nc\nh\nd\ne\ns\ni\ng\nn\nc\no\nn\ns\ni\ns\nt\ns\no\nf\nt\nw
