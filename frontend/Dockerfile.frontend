# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

# SSL sertifika sorununu geçici olarak çözmek için
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

# Build arguments for Next.js public environment variables
# These are optional - if not provided, will be empty and set at runtime
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AUTH_URL
ARG NEXT_PUBLIC_AUTH_ENABLED=true
ARG NEXT_PUBLIC_DEMO_MODE=false

# Set as environment variables for Next.js build
# If build args are empty, they will be set at runtime from container environment
# Next.js will use these at build-time, but they can be overridden at runtime
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_URL=${NEXT_PUBLIC_AUTH_URL}
ENV NEXT_PUBLIC_AUTH_ENABLED=${NEXT_PUBLIC_AUTH_ENABLED}
ENV NEXT_PUBLIC_DEMO_MODE=${NEXT_PUBLIC_DEMO_MODE}

# Install deps
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* .npmrc* ./

# Configure npm for better performance and reliability
RUN npm config set fetch-timeout 300000 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-retries 5 && \
    npm config set progress false && \
    npm config set loglevel warn && \
    npm config set audit false && \
    npm config set fund false

# Install dependencies with fallback strategy
RUN if [ -f package-lock.json ]; then \
        npm ci --prefer-offline --no-audit --no-fund || \
        (npm cache clean --force && npm ci --no-audit --no-fund); \
    elif [ -f pnpm-lock.yaml ]; then \
        corepack enable && pnpm install --frozen-lockfile --prefer-offline || \
        (pnpm store prune && pnpm install --frozen-lockfile); \
    elif [ -f yarn.lock ]; then \
        yarn install --frozen-lockfile --prefer-offline || \
        (yarn cache clean && yarn install --frozen-lockfile); \
    else \
        npm install --prefer-offline --no-audit --no-fund || \
        (npm cache clean --force && npm install --no-audit --no-fund); \
    fi

# Copy source and build - ensure all files are copied
COPY . .

# Debug: List directory structure to verify files are copied correctly
RUN ls -la && ls -la components/ && ls -la lib/ && ls -la contexts/

# Clear Next.js cache and build without cache
RUN rm -rf .next
RUN npm run build

# Runtime stage
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy only necessary artifacts for standalone mode
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
