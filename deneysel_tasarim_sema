digraph {
	rankdir=LR splines=ortho
	node [color="#333333" fillcolor=white fontname=Arial fontsize=10 shape=box style="rounded,filled"]
	edge [color="#555555" fontname=Arial fontsize=9]
	subgraph cluster_data {
		color="#888888" fontcolor="#666666" label="1. Veri Seti Hazırlığı" style=dashed
		PDF [label="Ders Materyali
(120 Sayfa PDF)" fillcolor="#E3F2FD"]
		QA [label="Soru Havuzu
(50 Adet)" fillcolor="#E3F2FD"]
		GT [label="Referans Yanıtlar
(Ground Truth)" fillcolor="#E3F2FD"]
	}
	subgraph cluster_system {
		color="#888888" fontcolor="#666666" label="2. Test Ortamı (AkıllıRehber)" style=dashed
		RAG [label="RAG Pipeline
(Retrieval + Generation)" fillcolor="#FFF3E0" shape=component]
		Output [label="Sistem Yanıtı
(Generated Answer)" fillcolor="#FFF8E1"]
	}
	subgraph cluster_eval {
		color="#888888" fontcolor="#666666" label="3. Değerlendirme Metrikleri" style=dashed
		Retrieval_Metrics [label="Erişim Kalitesi
- Cosine Similarity
- Precision@5" fillcolor="#E8F5E9" shape=note]
		Gen_Metrics [label="Üretim Kalitesi
- Semantic Similarity
(Embedding Cosine)" fillcolor="#E8F5E9" shape=note]
		Perf_Metrics [label="Performans
- Latency (ms)" fillcolor="#FCE4EC" shape=note]
	}
	PDF -> RAG [label=Indexing]
	QA -> RAG [label=Sorgu]
	RAG -> Output [label="Üretim"]
	RAG -> Perf_Metrics [style=dotted]
	Output -> Gen_Metrics [label="Karşılaştırma"]
	GT -> Gen_Metrics
	RAG -> Retrieval_Metrics [label="Chunk Analizi"]
}
