<mxfile host="app.diagrams.net">
  <diagram name="Consensus Mechanism" id="consensus">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Agent Inputs -->
        <mxCell id="input-label" value="Agent Outputs" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="100" height="20" as="geometry"/>
        </mxCell>
        
        <mxCell id="a1" value="Structural Agent&#xa;d₁, c₁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="100" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="Semantic Agent&#xa;d₂, c₂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="100" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="Size Agent&#xa;d₃, c₃" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="100" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="Quality Agent&#xa;d₄, c₄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="100" height="45" as="geometry"/>
        </mxCell>
        
        <!-- Weights -->
        <mxCell id="weight-label" value="Weights" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="60" height="20" as="geometry"/>
        </mxCell>
        
        <mxCell id="w1" value="w₁=0.35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="70" width="60" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="w₂=0.30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="125" width="60" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="w3" value="w₃=0.20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="60" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="w₄=0.15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="235" width="60" height="25" as="geometry"/>
        </mxCell>
        
        <!-- Multiplication -->
        <mxCell id="mult" value="×" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="140" width="40" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Summation -->
        <mxCell id="sum" value="Σ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="40" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Score Calculation Box -->
        <mxCell id="score-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="180" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="score-label" value="Score Calculation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="65" width="100" height="15" as="geometry"/>
        </mxCell>
        
        <mxCell id="split-score" value="Split Score&#xa;Σ(wᵢ×cᵢ×I[split])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="merge-score" value="Merge Score&#xa;Σ(wᵢ×cᵢ×I[merge])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="145" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="compare" value="Compare" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="80" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Priority Rules -->
        <mxCell id="priority-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="60" width="160" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="priority-label" value="Priority Rules" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="65" width="80" height="15" as="geometry"/>
        </mxCell>
        
        <mxCell id="p1" value="1. PRESERVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="90" width="120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="2. FORCE_SPLIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="3. FORCE_MERGE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="4. SPLIT/MERGE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="180" width="120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="5. NEUTRAL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="120" height="25" as="geometry"/>
        </mxCell>
        
        <!-- Final Output -->
        <mxCell id="final" value="Final&#xa;Decision" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="80" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arr1" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1" source="a1" target="mult">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr2" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1" source="a2" target="mult">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr3" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1" source="a3" target="mult">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr4" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1" source="a4" target="mult">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr5" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1" source="mult" target="sum">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr6" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1" source="sum" target="score-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr7" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1" source="score-box" target="priority-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr8" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1" source="priority-box" target="final">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Formula at bottom -->
        <mxCell id="formula-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="590" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="formula" value="Consensus Formula:  Score = Σᵢ (wᵢ × cᵢ × I[dᵢ])&#xa;&#xa;where: wᵢ = agent weight,  cᵢ = confidence,  dᵢ = decision,  I[·] = indicator function" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="570" height="60" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>