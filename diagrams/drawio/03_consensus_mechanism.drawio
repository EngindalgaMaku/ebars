        <mxCell id="a4" value="Quality Agent&#xa;d₄: APPROVED&#xa;c₄: 0.88" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=1.5;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="45" y="205" width="110" height="40" as="geometry"/>
