        <mxCell id="a3" value="Size Agent&#xa;d₃: ALLOW_SPLIT&#xa;c₃: 0.70" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;strokeWidth=1.5;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="45" y="160" width="110" height="40" as="geometry"/>
