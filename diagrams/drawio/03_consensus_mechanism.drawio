        <mxCell id="case-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;dashed=1;" value="" vertex="1">
          <mxGeometry height="170" width="450" x="30" y="310" as="geometry" />
        </mxCell>
        <mxCell id="case-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=11;" value="Case Study: Conflict Resolution" vertex="1">
          <mxGeometry height="20" width="170" x="170" y="315" as="geometry" />
        </mxCell>
        <mxCell id="case-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=10;spacingTop=5;" value="Scenario: Code block detected within a large chunk&#xa;&#xa;• Structural Agent: PRESERVE (c=0.95) ← Code block detected&#xa;• Semantic Agent: SPLIT (c=0.78) ← Topic change detected&#xa;• Size Agent: FORCE_SPLIT (c=0.85) ← Chunk exceeds max_size&#xa;&#xa;Resolution: PRESERVE wins (Safety Constraint #1)&#xa;Reason: &quot;Atomic unit integrity &gt; size constraints&quot;&#xa;&#xa;Note: PRESERVE acts as a SAFETY CONSTRAINT&#xa;      preventing semantic loss from splitting atomic units" vertex="1">
          <mxGeometry height="130" width="430" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="formula-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;dashed=1;" value="" vertex="1">
          <mxGeometry height="140" width="460" x="500" y="340" as="geometry" />
        </mxCell>
        <mxCell id="formula-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=11;" value="Mathematical Formulation" vertex="1">
          <mxGeometry height="20" width="160" x="650" y="345" as="geometry" />
        </mxCell>
        <mxCell id="formula-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=10;spacingTop=5;fontFamily=Courier New;" value="Consensus Score:&#xa;  Split_Score = Σᵢ (wᵢ × cᵢ × I[dᵢ ∈ {SPLIT, FORCE_SPLIT, ALLOW_SPLIT}])&#xa;  Merge_Score = Σᵢ (wᵢ × cᵢ × I[dᵢ ∈ {MERGE, FORCE_MERGE}])&#xa;&#xa;Notation:&#xa;  wᵢ = weight of agent i,  cᵢ = confidence [0,1]&#xa;  dᵢ = decision,  I[·] = indicator function {0,1}&#xa;  θ = 0.5 (consensus threshold)" vertex="1">
          <mxGeometry height="100" width="440" x="510" y="370" as="geometry" />
        </mxCell>
